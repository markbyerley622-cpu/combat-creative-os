# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Env files (never commit real secrets/config)
.env
.env.*.local
.env.local
!.env.example

# Prisma
packages/database/prisma/migrations/**/migration_lock.toml.bak

# Test / coverage
coverage/
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# MinIO / Postgres local volumes (if bind-mounted during local dev)
infrastructure/.data/

# AAMP render output — generated MP4s, QA reports, asset records and job temp
# directories. Never commit generated video.
.aamp-output/

# Synthetic render fixtures, rebuilt with `pnpm aamp:fixtures`. The manifest
# that references them is committed; the media it generates is not.
packages/media/fixtures/generated/

# The synthetic external asset root the zero-cost preview runs against —
# brand/, app-ui/, combat-clips/, audio/ and references/. Rebuilt with
# `pnpm aamp:fixtures`. No external, licensed or copyrighted media is ever
# committed; the manifest and the creative plan that describe it are.
packages/media/fixtures/preview-asset-root/

# Creative Memory analysis output — proxies, extracted frames, scene clips,
# transcripts and FiftyOne projections derived from reference advertisements.
# Reference material is analysis-only and third-party; none of it is ever
# committed. The manifests that describe it are committed; the media is not.
.aamp-reference-analysis/
packages/media/fixtures/reference-generated/

# Creative Memory retrieval — local Qdrant storage (Docker named volume is
# separate, but a bind-mounted or embedded store must never be committed) and
# any model cache. No vectors, weights or endpoint credentials are committed.
.qdrant/
qdrant_storage/
.aamp-model-cache/
