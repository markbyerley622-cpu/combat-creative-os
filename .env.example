# Combat Creative OS — local development environment
#
# Copy this file to `.env` (`cp .env.example .env`) and adjust if needed.
# Every value below is a placeholder / local-only default — none of these are
# real secrets, and this file must never contain one. `.env` itself is
# git-ignored; only `.env.example` is committed.

# --- General -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (application database) ----------------------------------
# Matches the credentials seeded by infrastructure/docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=combat_creative_os
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/combat_creative_os?schema=public

# --- Temporal ------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=combat-creative-os

# --- MinIO (S3-compatible object storage) ---------------------------------
# minioadmin/minioadmin are MinIO's own documented local-dev defaults.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=combat-creative-assets

# --- apps/api --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000

# --- apps/worker -------------------------------------------------------------
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4100

# --- apps/dashboard ------------------------------------------------------------
# Base URL the dashboard uses to reach the control-plane API (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# --- Observability -----------------------------------------------------------
# Leave empty to disable OTLP export locally (traces/logs stay local only).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Reasoning provider (specialist-agent execution framework) -------------
# 'mock' (default) never calls a real API and never spends money — safe for
# local dev and CI. Only switch to 'claude' with a real ANTHROPIC_API_KEY as
# an explicit, separate decision (CLAUDE.md "Provider-adapter rules").
REASONING_PROVIDER=mock
REASONING_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
