# Combat Creative OS — local development environment
#
# Copy this file to `.env` (`cp .env.example .env`) and adjust if needed.
# Every value below is a placeholder / local-only default — none of these are
# real secrets, and this file must never contain one. `.env` itself is
# git-ignored; only `.env.example` is committed.

# --- General -----------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (application database) ----------------------------------
# Matches the credentials seeded by infrastructure/docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=combat_creative_os
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/combat_creative_os?schema=public

# --- Temporal ------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=combat-creative-os

# --- MinIO (S3-compatible object storage) ---------------------------------
# minioadmin/minioadmin are MinIO's own documented local-dev defaults.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=combat-creative-assets
# "us-east-1" is accepted by MinIO regardless of real AWS geography — it's a
# required S3 API parameter here, not a real region choice.
MINIO_REGION=us-east-1
# MinIO (and most self-hosted S3-compatible stores) requires path-style
# addressing; set to false for real AWS S3 in production.
MINIO_FORCE_PATH_STYLE=true

# --- Asset ingestion (M5) ---------------------------------------------------
ASSET_MAX_UPLOAD_BYTES=209715200
ASSET_UPLOAD_URL_EXPIRY_SECONDS=900
ASSET_DOWNLOAD_URL_EXPIRY_SECONDS=3600

# --- apps/api --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000

# --- apps/worker -------------------------------------------------------------
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4100

# --- Authentication: Clerk (AAMP-1 step 2) ------------------------------------
# Clerk provides verified identity, sessions and sign-in. It is NOT the
# authorization system: workspace membership, role and every permission stay in
# PostgreSQL (docs/adr/0006). Clerk Organizations are deliberately disabled —
# introducing them would be a second, unaudited tenancy model.
#
# Fill these in from your own Clerk dashboard. Never commit real values: `.env`
# and `.env.local` are git-ignored, this file is not.
#
# CLERK_SECRET_KEY (server-side only, `sk_...`) — apps/api verifies every
# session token with it. apps/api REFUSES TO START without it: there is no
# "authentication disabled" mode, in any environment. Never expose this to the
# browser; a `pk_...` value here is rejected at the config boundary.
CLERK_SECRET_KEY=
#
# CLERK_AUTHORIZED_PARTIES — comma-separated origins whose session tokens
# apps/api accepts (the token's `azp` claim). Optional locally; REQUIRED when
# NODE_ENV=production, because without it a token minted for a different
# front-end can be replayed against this API.
# Example: https://app.example.com,https://admin.example.com
CLERK_AUTHORIZED_PARTIES=

# --- apps/dashboard ------------------------------------------------------------
# Base URL the dashboard uses to reach the control-plane API (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000
#
# The dashboard holds no secret. It needs only the PUBLISHABLE key (`pk_...`),
# which Clerk designs to ship in the client bundle, plus the two route names.
# `clerk init` writes these into the git-ignored apps/dashboard/.env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
#
# NEXT_PUBLIC_DASHBOARD_AUTH_MODE — leave unset (or `clerk`). The only other
# value, `e2e-fake`, exists so the Playwright suite runs with no Clerk account
# or network access; it is refused when NEXT_PUBLIC_DEPLOY_ENV=production, and
# grants nothing regardless because apps/api verifies every token independently.
NEXT_PUBLIC_DASHBOARD_AUTH_MODE=
NEXT_PUBLIC_DEPLOY_ENV=local

# --- Observability -----------------------------------------------------------
# Leave empty to disable OTLP export locally (traces/logs stay local only).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Reasoning provider (specialist-agent execution framework) -------------
# 'mock' (default) never calls a real API and never spends money — safe for
# local dev and CI. Only switch to 'claude' with a real ANTHROPIC_API_KEY as
# an explicit, separate decision (CLAUDE.md "Provider-adapter rules").
REASONING_PROVIDER=mock
REASONING_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# --- Video-generation provider (AAMP generation vertical slice 2) -----------
# 'mock' (default) produces metadata-only placeholders and never spends money
# or touches a GPU — what CI and local tests run on. 'comfyui' selects the real
# ComfyUI adapter.
#
# Two combinations are refused at startup rather than degraded silently:
#   * mock + NODE_ENV=production — a production process running the mock would
#     deliver a fabricated advertisement while every gate reported success;
#   * comfyui with no COMFYUI_BASE_URL.
# See docs/runbooks/comfyui-video-generation.md for setup, profiles, model
# provenance, licensing and failure modes.
#
# Still true for Veo/Runway: no adapter exists and none may be connected
# without an explicit, separate decision (CLAUDE.md "Provider-adapter rules").
VIDEO_GENERATION_PROVIDER=mock

# Origin of the ComfyUI server, e.g. http://127.0.0.1:8188. Required when
# VIDEO_GENERATION_PROVIDER=comfyui. Must be http: or https:.
COMFYUI_BASE_URL=

# End-to-end deadline for generating ONE shot, in milliseconds — not a
# per-HTTP-request timeout. Video sampling is minutes of GPU work.
COMFYUI_OUTPUT_TIMEOUT_MS=900000

# Which versioned, provider-owned workflow profile to run. LTX_2_3_DRAFT is the
# only selectable profile; HUNYUAN_VIDEO_1_5_QUALITY is declared but refuses to
# build a graph until its template is verified against a live server.
COMFYUI_WORKFLOW_PROFILE=LTX_2_3_DRAFT

# Client identity ComfyUI associates this process's queue and websocket with.
COMFYUI_CLIENT_ID=combat-creative-os

# Optional. A self-hosted ComfyUI has no authentication; set this only when the
# endpoint sits behind an authenticating proxy. Secret — never commit a real
# value, and never expose it to any client bundle.
COMFYUI_API_KEY=

# Where retrieved generated clips are written. Repository-relative unless
# absolute. Git-ignored: generated media is never committed.
COMFYUI_OUTPUT_DIR=.aamp-output/generated

# ---------------------------------------------------------------------------
# Controlled creative benchmark (pnpm aamp:benchmark)
# ---------------------------------------------------------------------------
# What you believe a million tokens costs, in cents, for the configured model.
#
# Deliberately blank. `aamp:benchmark --allow-paid-providers` refuses to
# authorise a paid call unless it can compute and print an estimated MAXIMUM
# cost first, and it cannot compute one without these. Paid work is never
# authorised against an unknown number, and a hardcoded price table in this
# repository would go stale silently. These are estimates you declare, not a
# quote and not a measurement — the CLI meters no spend.
BENCHMARK_INPUT_COST_CENTS_PER_MTOK=
BENCHMARK_OUTPUT_COST_CENTS_PER_MTOK=

# ---------------------------------------------------------------------------
# Premium licensed media acquisition (pnpm aamp:media)
# ---------------------------------------------------------------------------
# Official provider APIs only. There is no scraper, no yt-dlp, no browser
# download path, and no adapter for YouTube, TikTok, Instagram, Facebook, UFC,
# ONE Championship, DAZN, the Internet Archive or any social-media mirror -
# none of them grants a third party reuse rights for advertising.
#
# Every key below is OPTIONAL and deliberately blank. An unset key means that
# provider reports NOT_CONFIGURED and contributes nothing to a search. Nothing
# falls back to scraping and nothing invents a catalogue entry.
#
# Wikimedia Commons and Openverse need no key and so have none here.
#
# Free key, self-service: https://www.pexels.com/api/
PEXELS_API_KEY=
# Free key, self-service: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# DVIDS issues keys to identified organisations: https://api.dvidshub.net/
# DVIDS hosts both US Government public-domain work AND separately copyrighted
# material. This adapter treats an item as public domain only when the response
# says so AT ITEM LEVEL, and refuses anything ambiguous.
DVIDS_API_KEY=

# Per-request deadline for a provider API call, in milliseconds.
MEDIA_ACQUISITION_TIMEOUT_MS=20000

# Ceiling for one downloaded file, in bytes (512 MB).
MEDIA_ACQUISITION_MAX_DOWNLOAD_BYTES=536870912

# Providers ask for a descriptive, contactable User-Agent; Wikimedia's policy
# makes it a condition of access. Leave blank to use the built-in default, or
# set your own with a contact address.
MEDIA_ACQUISITION_USER_AGENT=

# Where acquired media lands. Repository-relative unless absolute. Git-ignored:
# licensed third-party media is never committed.
MEDIA_ACQUISITION_OUTPUT_DIR=.aamp-output/acquired-assets
