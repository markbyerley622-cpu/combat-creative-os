// Combat Creative OS — foundation schema.
//
// Tenancy core (Workspace, User, Role, Membership) plus the full campaign
// production domain model — see docs/domain-model.md for an ER diagram, the
// campaign state machine this schema backs, and worked examples.
//
// Tenancy-scoping convention (docs/architecture.md §4.4, CLAUDE.md): every
// table below carries a `workspaceId` column with an index. A real FK
// relation to Workspace (with back-relation array) is declared only on
// aggregate roots that are queried/created directly by API/activity code
// (Campaign, Asset, HumanApproval, PromptTemplate, BudgetPolicy,
// BudgetLedgerEntry, CampaignTransitionAudit) — deeply-nested child tables
// (Shot, ShotSpecification, QualityFailure, etc.) rely on their immediate
// parent's FK chain up to Campaign/Workspace for referential integrity, and
// carry `workspaceId` as a denormalized, indexed scoping column so the
// repository layer can always filter directly on it without joining up the
// chain (see packages/database's repository rule in CLAUDE.md). This keeps
// the schema's relation graph readable while still satisfying "every
// workspace-owned table gets a workspaceId column and an index on it."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER_ADMIN
  CREATIVE_DIRECTOR
  PRODUCTION_OPERATOR
  REVIEWER
  ANALYST
}

model Workspace {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  campaigns                Campaign[]
  assets                   Asset[]
  promptTemplates          PromptTemplate[]
  budgetPolicies           BudgetPolicy[]
  campaignTransitionAudits CampaignTransitionAudit[]
  agentInvocations         AgentInvocation[]
  deliveryProfiles         DeliveryProfile[]
  performanceObservations  PerformanceObservation[]
  learningRecords          LearningRecord[]

  // Creative Memory. Aggregate roots only, per the tenancy-scoping convention
  // above; the reference child tables reach Workspace through this FK chain
  // and carry `workspaceId` as a denormalized scoping column.
  referenceSources         ReferenceSource[]
  referenceAdvertisements  ReferenceAdvertisement[]

  @@map("workspaces")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  displayName String
  // AAMP-1 step 2: the verified Clerk subject (`sub`) this local user is the
  // authorization identity for. Clerk proves *who* the caller is; every
  // permission decision still reads Membership/RoleName below, so this column
  // is a mapping key and nothing else — no role, workspace or entitlement is
  // ever derived from it (docs/adr/0006).
  //
  // Nullable because a User may exist before it has ever signed in (seeded
  // fixtures, invited members). Unique so one Clerk subject can never resolve
  // to two local users, which is what makes first-login provisioning safely
  // idempotent under concurrency.
  clerkUserId String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

model Membership {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        RoleName
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Campaign production domain (docs/domain-model.md)
// ---------------------------------------------------------------------------

// 20-stage canonical campaign-production lifecycle — see
// docs/domain-model.md §4 and docs/adr/0002-campaign-lifecycle-alignment.md.
// Performance analysis is intentionally NOT represented here; it runs as a
// separate, decoupled PerformanceAnalysisWorkflow over completed campaign/
// distribution records so this workflow can complete without waiting on
// advertising results.
enum CampaignStage {
  DRAFT
  STRATEGY_REVIEW
  CONCEPT_REVIEW
  SCRIPT_REVIEW
  ASSET_COLLECTION
  PROMPTING
  SHOT_GENERATION
  VISUAL_QA
  CONTINUITY_QA
  HUMAN_SHOT_SELECTION
  COMPOSITING
  ROUGH_CUT
  SOUND_DESIGN
  FINAL_QA
  FINAL_APPROVAL
  VARIANT_GENERATION
  VARIANT_QA
  EXPORTING
  READY_FOR_DISTRIBUTION
  DISTRIBUTED
}

enum DeliveryPlatform {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
  GENERIC
}

enum BudgetLevel {
  WORKSPACE
  CAMPAIGN
  SHOT
  PROVIDER
}

enum BudgetLedgerEntryType {
  RESERVATION
  CHARGE
  RELEASE
}

// Only the three architecturally-required gates. STRATEGY_REVIEW and
// SCRIPT_REVIEW are checkpoint stages, not gates — see decision 9 in
// docs/adr/0002-campaign-lifecycle-alignment.md.
enum ApprovalGate {
  CONCEPT
  SHOT_SELECTION
  FINAL
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum AssetKind {
  /// M5: a file uploaded directly by a user — the only kind the ingestion service itself creates.
  UPLOADED_SOURCE
  VIDEO_CANDIDATE
  THUMBNAIL
  PROXY
  MOTION_GRAPHICS_RENDER
  /// M9: the assembled rough-edit render from a RoughEditSpecification.
  ROUGH_CUT
  SOUND_STEM
  FINAL_MASTER
  VARIANT
  DESIGN_EXPORT
}

enum GenerationCandidateStatus {
  PENDING
  SUBMITTED
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ShotGenerationJobStatus {
  PENDING
  DISPATCHED
  SUCCEEDED
  FAILED
  BUDGET_EXCEEDED
  CANCELLED
}

/// Per-attempt provider job status, mirrored from `@combat/providers`'s `JobStatus`.
enum ShotGenerationAttemptStatus {
  QUEUED
  SUBMITTED
  POLLING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ShotGenerationFailureReason {
  UNSUPPORTED_CAPABILITY
  PROVIDER_TIMEOUT
  PROVIDER_REJECTED
  PROVIDER_ERROR
  BUDGET_EXCEEDED
}

enum MotionIntensity {
  STATIC
  LOW
  MEDIUM
  HIGH
}

enum TextSafeArea {
  TOP
  BOTTOM
  LEFT
  RIGHT
  CENTER
  FULL_SAFE
}

// SHOT_UNUSABLE/COMPOSITING_TECHNICAL/EDIT_TIMING/AUDIO_TECHNICAL drive typed
// revision routing for stages with more than one valid repair target — see
// packages/domain/src/workflow/quality-failure-routing.ts.
enum QualityFailureCategory {
  PROMPT
  GENERATION
  CONTINUITY
  TECHNICAL
  SHOT_UNUSABLE
  COMPOSITING_TECHNICAL
  EDIT_TIMING
  AUDIO_TECHNICAL
}

enum QualityFailureSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum AssessedBy {
  AGENT
  HUMAN
}

enum RenderJobKind {
  COMPOSITING
  EXPORT
}

enum RenderJobStatus {
  QUEUED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SoundCueType {
  MUSIC
  SFX
  VOICEOVER
}

enum TransitionType {
  CUT
  DISSOLVE
  WIPE
  FADE_IN
  FADE_OUT
}

enum ShotStatus {
  PENDING
  GENERATING
  QC_REVIEW
  NEEDS_HUMAN
  BUDGET_EXCEEDED
  SELECTED
  REJECTED
}

enum LicenseType {
  FULL_BUY_OUT
  LIMITED_USAGE
  ROYALTY_FREE
  EXCLUSIVE
}

enum CreativeVariantStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

/// M12 — variant-render job/attempt lifecycle. Mirrors the M9 composition
/// enums; kept separate so the two lifecycles can diverge independently.
enum VariantGenerationJobStatus {
  PENDING
  DISPATCHED
  SUCCEEDED
  FAILED
  BUDGET_EXCEEDED
  CANCELLED
}

enum VariantGenerationAttemptStatus {
  QUEUED
  SUBMITTED
  POLLING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum VariantGenerationFailureReason {
  UNSUPPORTED_CAPABILITY
  PROVIDER_TIMEOUT
  PROVIDER_REJECTED
  PROVIDER_ERROR
  BUDGET_EXCEEDED
  INVALID_CUT
  STALE_MASTER
}

/// M13 — where a performance observation came from. Deliberately excludes any
/// real ad-platform connector: no social/ad API integration, scraping or
/// credential exists (architecture.md §8's M13 entry). A real connector adds a
/// value here without changing anything downstream.
enum PerformanceSource {
  FIXTURE
  MANUAL_ENTRY
}

/// M13 — which agent a learning may ever be offered to. Only STRATEGY and
/// CONCEPT are consumed today (architecture.md §5: "strategy/concept only").
enum LearningScope {
  STRATEGY
  CONCEPT
  PROMPTING
}

/// M13 — derived from evidence volume by `deriveLearningConfidence`, never
/// asserted by the agent that wrote the insight.
enum LearningConfidence {
  LOW
  MEDIUM
  HIGH
}

/// M13 — a learning is written PROPOSED; a human approves it before any agent
/// can see it.
enum LearningStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum TransitionAuditResult {
  APPLIED
  REJECTED_INVALID_TRANSITION
  REJECTED_MISSING_PREREQUISITE
  REJECTED_BUDGET_EXCEEDED
  REJECTED_CONCURRENT_MODIFICATION
  DUPLICATE_IGNORED
}

enum EditTrackType {
  VIDEO
  AUDIO
}

/// Campaign is the aggregate root the state machine (packages/domain/src/workflow)
/// operates on. `version` is an optimistic-concurrency counter — every applied
/// transition is a compare-and-swap update on (id, workspaceId, currentStage,
/// version), which is what makes concurrent transition attempts safe without
/// a Postgres advisory lock (see campaign-transition-service.ts).
model Campaign {
  id             String        @id @default(uuid())
  workspaceId    String
  name           String
  /// Caller-supplied dedup key for POST /campaigns (M4) — same idempotency-key
  /// convention used elsewhere (AgentInvocation, CampaignTransitionAudit,
  /// BudgetLedgerEntry) rather than a new mechanism. Nullable (unlike those
  /// tables) so every pre-M4 test fixture that constructs a CampaignRecord
  /// without one stays valid — Postgres treats each NULL as distinct under
  /// a unique index, so this only enforces dedup when a caller supplies one.
  idempotencyKey String?
  currentStage   CampaignStage @default(DRAFT)
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  briefs               CampaignBrief[]
  strategies           Strategy[]
  concepts             CreativeConcept[]
  scripts              Script[]
  timelines            Timeline[]
  assets               Asset[]
  renderJobs           RenderJob[]
  editDecisionLists    EditDecisionList[]
  deliverySpecs          DeliverySpecification[]
  creativeVariants       CreativeVariant[]
  variantSpecifications  VariantSpecification[]
  variantGenerationJobs  VariantGenerationJob[]
  performanceObservations PerformanceObservation[]
  learningRecords         LearningRecord[]
  humanApprovals         HumanApproval[]
  transitionAudits     CampaignTransitionAudit[]
  agentInvocations     AgentInvocation[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@map("campaigns")
}

/// Versioned and immutable once accepted (`acceptedAt` set) — a revision is a
/// new row with an incremented `version`, never a mutation of an existing one.
// M4: the full campaign-brief field set the dashboard's brief editor
// collects — see packages/domain's CampaignBriefContentSchema, the
// single source of truth this model's fields mirror field-for-field.
// Unmigrated (no prisma/migrations directory exists yet, see
// docs/architecture.md §7.1 item 11), so these fields were extended in
// place for M4 rather than added via a follow-up migration.
model CampaignBrief {
  id                 String             @id @default(uuid())
  workspaceId        String
  campaignId         String
  version            Int
  campaignName       String
  productName        String
  productDescription String
  objective          String
  targetAudience     String
  customerProblem    String
  valueProposition   String
  productFeatures    String[]
  targetPlatforms    DeliveryPlatform[]
  aspectRatios       String[]
  durationsSeconds   Int[]
  brandVoice         String
  visualDirection    String
  requiredMessaging  String[]
  callToAction       String
  references         String[]
  assetReferences    String[]
  prohibitedClaims   String[]
  budgetCents        Int
  deadline           DateTime?
  locale             String             @default("en-US")
  notes              String?
  acceptedAt         DateTime?
  createdAt          DateTime           @default(now())

  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audienceProfiles AudienceProfile[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("campaign_briefs")
}

// M4: Campaign Strategist's output, persisted as an immutable versioned
// row (packages/domain's StrategySchema). `audienceProfile` is stored as
// JSON rather than reusing the AudienceProfile model above — that model is
// FK-scoped to CampaignBrief, a different aggregate, and isn't guaranteed
// shape-identical to what the agent returns.
model Strategy {
  id                    String   @id @default(uuid())
  workspaceId           String
  campaignId            String
  version               Int
  positioning           String
  targetAudienceSummary String
  keyMessages           String[]
  toneGuidelines        String[]
  audienceProfile       Json
  createdAt             DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("strategies")
}

model AudienceProfile {
  id               String   @id @default(uuid())
  workspaceId      String
  campaignBriefId  String
  name             String
  demographics     Json     @default("{}")
  psychographics   Json     @default("{}")
  painPoints       String[]
  platformBehavior Json     @default("{}")
  createdAt        DateTime @default(now())

  campaignBrief CampaignBrief @relation(fields: [campaignBriefId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignBriefId])
  @@map("audience_profiles")
}

model CreativeConcept {
  id              String   @id @default(uuid())
  workspaceId     String
  campaignId      String
  version         Int
  logline         String
  visualDirection String
  narrativeArc    String
  referenceNotes  String[]
  createdAt       DateTime @default(now())

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  visualLanguage VisualLanguage?
  scripts        Script[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("creative_concepts")
}

/// One-to-one with CreativeConcept — a concept version has exactly one visual
/// language spec; a revised concept version gets a new VisualLanguage row.
model VisualLanguage {
  id                String   @id @default(uuid())
  workspaceId       String
  creativeConceptId String   @unique
  colorPalette      String[]
  typography        Json     @default("{}")
  motionPrinciples  String[]
  brandAssetRefs    String[]
  createdAt         DateTime @default(now())

  creativeConcept CreativeConcept @relation(fields: [creativeConceptId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("visual_languages")
}

model Script {
  id                  String   @id @default(uuid())
  workspaceId         String
  campaignId          String
  creativeConceptId   String
  version             Int
  totalDurationFrames Int
  createdAt           DateTime @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeConcept CreativeConcept @relation(fields: [creativeConceptId], references: [id], onDelete: Restrict)
  shots           Shot[]
  timelines       Timeline[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("scripts")
}

// Script & Timing Director's per-shot narrative-beat classification
// (packages/agents/src/script-timing-director/schema.ts's ShotBeatSchema;
// packages/domain mirrors these same four values as ShotBeatSchema so the
// domain package doesn't need to depend on packages/agents).
enum ShotBeat {
  HOOK
  PROMISE
  FEATURE
  CTA
}

model Shot {
  id               String     @id @default(uuid())
  workspaceId      String
  scriptId         String
  index            Int
  description      String
  durationFrames   Int
  beat             ShotBeat
  status           ShotStatus @default(PENDING)
  dependsOnShotIds String[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  script             Script               @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shotSpecifications ShotSpecification[]
  timelineEntries    TimelineEntry[]

  @@unique([scriptId, index])
  @@index([workspaceId])
  @@map("shots")
}

/// Reusable edit-transition definition (cut/dissolve/wipe/fade), referenced by
/// TimelineEntry. Not to be confused with campaign *stage* transitions.
model TransitionSpecification {
  id             String         @id @default(uuid())
  workspaceId    String
  type           TransitionType
  durationFrames Int
  easing         String?
  params         Json           @default("{}")
  createdAt      DateTime       @default(now())

  timelineEntries TimelineEntry[]

  @@index([workspaceId])
  @@map("transition_specifications")
}

model Timeline {
  id            String   @id @default(uuid())
  workspaceId   String
  campaignId    String
  scriptId      String
  version       Int
  frameRate     Int      @default(30)
  durationFrames Int
  createdAt     DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  script   Script          @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  entries  TimelineEntry[]
  soundCues SoundCue[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("timelines")
}

model TimelineEntry {
  id                        String   @id @default(uuid())
  workspaceId               String
  timelineId                String
  shotId                    String
  transitionSpecificationId String?
  order                     Int
  startFrame                Int
  durationFrames            Int

  timeline               Timeline                 @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  shot                   Shot                     @relation(fields: [shotId], references: [id], onDelete: Restrict)
  transitionSpecification TransitionSpecification? @relation(fields: [transitionSpecificationId], references: [id], onDelete: SetNull)

  @@unique([timelineId, order])
  @@index([workspaceId])
  @@map("timeline_entries")
}

/// Canonical, immutable, versioned generation brief for one shot (M6
/// requirement 3) — the entity the Shot Prompt Engineer agent's output is
/// persisted as. Supersedes the earlier, thinner `GenerationPrompt` model:
/// same slot in the ER graph (a versioned prompt per shot per provider —
/// docs/architecture.md §4), extended with the full structured brief a real
/// shot-generation dispatch needs (framing, continuity, licensing, quality
/// rubric, etc). `promptVersionId` stays a required (non-nullable) FK —
/// CLAUDE.md "Prompt version used for every generation must be recorded" is
/// enforced at the database level, not left to callers to remember.
/// `campaignId`/`creativeConceptId`/`creativeConceptVersion`/`scriptId`/
/// `scriptVersion` are point-in-time-pinned plain columns, not live FKs —
/// this row must keep recording which concept/script version it was
/// generated against even if a later revision supersedes those upstream
/// rows (same "denormalized snapshot, not a live join" rationale as
/// AssetProvenance.derivedFromAssetIds).
model ShotSpecification {
  id                     String   @id @default(uuid())
  workspaceId            String
  campaignId             String
  creativeConceptId      String
  creativeConceptVersion Int
  scriptId               String
  scriptVersion          Int
  shotId                 String
  version                Int

  shotNumber              Int
  sequencePosition        Int
  intendedDurationSeconds Float

  visualObjective          String
  action                   String
  subject                  String
  environment              String
  cameraMovement           String
  lensFraming              String
  lighting                 String
  colorTreatment           String
  motionIntensity          MotionIntensity
  transitionIn             TransitionType
  transitionOut            TransitionType
  textSafeAreas            TextSafeArea[]
  appInterfaceRequirements String?

  referenceAssetIds       String[]
  continuityRequirements  String[]

  providerId        String
  promptVersionId    String
  generationPrompt   String
  negativePrompt     String?
  generationParams   Json     @default("{}")

  outputRequirements Json     @default("{}")
  qualityRubric      String[]
  licensingConstraints String[]

  createdByAgentInvocationId String
  createdAt                  DateTime @default(now())

  shot          Shot                  @relation(fields: [shotId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  candidates    GenerationCandidate[]
  generationJobs ShotGenerationJob[]

  @@unique([shotId, version])
  @@index([workspaceId])
  @@index([shotId])
  @@index([campaignId])
  @@map("shot_specifications")
}

/// Groups the bounded-retry attempt sequence for one ShotSpecification.
/// Mutable status/updatedAt row — same pattern already established by
/// RenderJob/CreativeVariant — because a job's status legitimately changes
/// as attempts are dispatched and resolved.
model ShotGenerationJob {
  id                      String                  @id @default(uuid())
  workspaceId             String
  campaignId              String
  shotSpecificationId     String
  status                  ShotGenerationJobStatus @default(PENDING)
  requestedCandidateCount Int
  maxAttempts             Int
  attemptCount            Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  shotSpecification ShotSpecification       @relation(fields: [shotSpecificationId], references: [id], onDelete: Cascade)
  attempts          ShotGenerationAttempt[]

  @@unique([shotSpecificationId])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("shot_generation_jobs")
}

/// One bounded-retry attempt within a ShotGenerationJob — append-only retry
/// history. `idempotencyKey` is unique per job so a replayed/retried
/// Activity call for the same attempt never double-submits to the provider
/// or double-reserves budget (CLAUDE.md workflow-idempotency rules).
model ShotGenerationAttempt {
  id                      String                      @id @default(uuid())
  workspaceId             String
  shotGenerationJobId     String
  attemptNumber           Int
  idempotencyKey          String
  providerId              String
  providerJobId           String?
  status                  ShotGenerationAttemptStatus @default(QUEUED)
  requestedCandidateCount Int
  seed                    Int?
  generationParams        Json                        @default("{}")
  budgetReservationId     String?
  estimatedCostCents      Int?
  actualCostCents         Int?
  failureReason           ShotGenerationFailureReason?
  failureRetryable        Boolean?
  failureMessage          String?
  startedAt               DateTime                    @default(now())
  completedAt             DateTime?
  createdAt               DateTime                    @default(now())

  shotGenerationJob ShotGenerationJob     @relation(fields: [shotGenerationJobId], references: [id], onDelete: Cascade)
  candidates        GenerationCandidate[]

  @@unique([shotGenerationJobId, idempotencyKey])
  @@index([workspaceId])
  @@index([shotGenerationJobId])
  @@map("shot_generation_attempts")
}

model GenerationCandidate {
  id                      String                    @id @default(uuid())
  workspaceId             String
  shotSpecificationId     String
  shotGenerationAttemptId String
  candidateIndex          Int
  assetId                 String?
  providerCandidateRef    String?
  seed                    Int?
  durationSeconds         Float?
  aspectRatio             String?
  status                  GenerationCandidateStatus @default(PENDING)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  shotSpecification     ShotSpecification     @relation(fields: [shotSpecificationId], references: [id], onDelete: Cascade)
  shotGenerationAttempt ShotGenerationAttempt @relation(fields: [shotGenerationAttemptId], references: [id], onDelete: Cascade)
  asset                 Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  qualityAssessments    QualityAssessment[]

  @@unique([shotGenerationAttemptId, candidateIndex])
  @@index([workspaceId])
  @@index([shotSpecificationId])
  @@index([shotGenerationAttemptId])
  @@map("generation_candidates")
}

/// Assesses either a GenerationCandidate (Visual QC) or a final-master Asset
/// (Final QA) — exactly one of generationCandidateId/assetId is set. This XOR
/// is an application-level invariant (see packages/domain's
/// QualityAssessmentSchema .refine and its repository-layer tests); Prisma
/// does not currently support a declarative cross-column CHECK constraint
/// for it.
model QualityAssessment {
  id                    String        @id @default(uuid())
  workspaceId           String
  // Campaign the assessed subject belongs to (M7) — campaign provenance and
  // the column the repository's mismatched-candidate guard compares against.
  campaignId            String
  generationCandidateId String?
  assetId               String?
  // Disambiguates which stage's output this assessment concerns (VISUAL_QA /
  // CONTINUITY_QA for a candidate; COMPOSITING / ROUGH_CUT / SOUND_DESIGN /
  // FINAL_QA for an asset) — see docs/domain-model.md §5.
  subjectStage          CampaignStage?
  pass                  Boolean
  scores                Json          @default("{}")
  // Aggregate score (mean of the per-criterion `scores`, M7). `pass` stays the
  // authoritative recommendation; this is the summary number.
  overallScore          Float         @default(0)
  assessedBy            AssessedBy
  // Agent invocation that produced this assessment (M7) — agent-invocation
  // provenance, nullable for a HUMAN-assessed record.
  createdByAgentInvocationId String?
  createdAt             DateTime      @default(now())

  generationCandidate GenerationCandidate? @relation(fields: [generationCandidateId], references: [id], onDelete: Cascade)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  failures            QualityFailure[]

  @@index([workspaceId])
  @@index([campaignId])
  @@index([generationCandidateId])
  @@index([assetId])
  // Idempotency identity for a candidate assessment: at most one assessment per
  // (candidate, subjectStage). Postgres treats NULL generationCandidateId rows
  // (asset-based assessments) as distinct, so this constrains candidate
  // assessments only — matching the repository's findFirst idempotency check.
  @@unique([generationCandidateId, subjectStage])
  @@map("quality_assessments")
}

model QualityFailure {
  id                  String                 @id @default(uuid())
  workspaceId         String
  qualityAssessmentId String
  category            QualityFailureCategory
  severity            QualityFailureSeverity
  description         String
  suggestedAction     String?
  createdAt           DateTime               @default(now())

  qualityAssessment QualityAssessment @relation(fields: [qualityAssessmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([qualityAssessmentId])
  @@map("quality_failures")
}

enum ShotSelectionSetStatus {
  DRAFT
  APPROVED
}

enum ShotSelectionEntryStatus {
  PENDING
  SELECTED
  REJECTED
}

/// M8 — one versioned revision of a reviewer's shot choices at
/// HUMAN_SHOT_SELECTION. DRAFT sets are editable; an APPROVED set is frozen
/// (the repository exposes no mutation of an APPROVED set). `revision` is an
/// optimistic-concurrency counter bumped on every draft mutation. FKs to
/// campaign/script/concept are plain columns (no relation back-reference),
/// matching QualityAssessment — the parent/child relation is only within this
/// selection aggregate.
model ShotSelectionSet {
  id                     String                  @id @default(uuid())
  workspaceId            String
  campaignId             String
  scriptId               String
  scriptVersion          Int
  creativeConceptId      String
  creativeConceptVersion Int
  version                Int
  status                 ShotSelectionSetStatus  @default(DRAFT)
  createdByUserId        String
  reviewerUserId         String?
  rationale              String?
  revision               Int                     @default(0)
  idempotencyKey         String?
  approvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  selections   ShotSelection[]
  replacements ShotSelectionReplacement[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("shot_selection_sets")
}

model ShotSelection {
  id                       String                   @id @default(uuid())
  workspaceId              String
  shotSelectionSetId       String
  shotId                   String
  sequencePosition         Int
  shotSpecificationId      String
  shotSpecificationVersion Int
  status                   ShotSelectionEntryStatus @default(PENDING)
  selectedCandidateId      String?
  visualQaAssessmentId     String?
  continuityQaAssessmentId String?
  rationale                String?
  regenerationFeedback     String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  shotSelectionSet ShotSelectionSet @relation(fields: [shotSelectionSetId], references: [id], onDelete: Cascade)

  @@unique([shotSelectionSetId, shotId])
  @@index([workspaceId])
  @@index([shotSelectionSetId])
  @@map("shot_selections")
}

/// Append-only history of candidate replacements within a draft set.
model ShotSelectionReplacement {
  id                  String   @id @default(uuid())
  workspaceId         String
  shotSelectionSetId  String
  shotId              String
  previousCandidateId String?
  newCandidateId      String?
  replacedByUserId    String
  reason              String?
  createdAt           DateTime @default(now())

  shotSelectionSet ShotSelectionSet @relation(fields: [shotSelectionSetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([shotSelectionSetId])
  @@map("shot_selection_replacements")
}

/// Immutable once created — architecture.md §0 guiding constraint 3. The
/// repository layer exposes only an insert for this table; a revised
/// decision is a new row, never an update of an existing one.
model HumanApproval {
  id               String           @id @default(uuid())
  workspaceId      String
  campaignId       String
  gate             ApprovalGate
  decision         ApprovalDecision
  stageAtDecision  CampaignStage
  decidedByUserId  String
  comments         String?
  // Required exactly when gate=FINAL and decision != APPROVED (see
  // HumanApprovalSchema's refine in packages/domain); the reviewer's choice
  // among the three valid FINAL_APPROVAL repair targets.
  repairTarget     CampaignStage?
  decidedAt        DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId, gate])
  @@map("human_approvals")
}

// M5: an uploaded asset's lifecycle after `putObject` succeeds — see
// packages/domain's AssetIngestionStatusSchema doc comment.
enum AssetIngestionStatus {
  PENDING
  READY
  FAILED
}

model Asset {
  id          String    @id @default(uuid())
  workspaceId String
  /// The campaign this asset was originally ingested for — see
  /// packages/domain's AssetSchema doc comment on why a workspace-wide
  /// checksum dedup means this isn't necessarily "the only campaign using
  /// this asset."
  campaignId  String
  kind        AssetKind
  s3Key       String    @unique
  checksum    String
  mimeType    String
  /// M5 additions — see packages/domain's AssetSchema.
  originalFilename        String
  sizeBytes               Int
  ingestionStatus         AssetIngestionStatus @default(PENDING)
  mediaMetadata           Json?
  inspectionFailureDetails String?

  createdByAgentInvocationId String?
  uploadedByUserId           String?
  /// M5: set (instead of the other two) for a derived asset an Activity
  /// produced deterministically (thumbnail/proxy) — see packages/domain's
  /// AssetSchema doc comment.
  generatedByActivity        String?
  createdAt                  DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  provenance           AssetProvenance?
  license              LicenseRecord?
  generationCandidates GenerationCandidate[]
  qualityAssessments   QualityAssessment[]
  renderJobOutputs     RenderJob[]
  soundCues            SoundCue[]
  editDecisionEntries  EditDecisionEntry[]
  creativeVariants     CreativeVariant[]
  variantSpecsAsParent VariantSpecification[] @relation("VariantParentMaster")

  // Dedup key for "detects duplicate uploads using workspace, checksum and
  // asset type" — deliberately excludes campaignId (a re-upload of the same
  // bytes to a different campaign in the same workspace reuses this row).
  @@unique([workspaceId, checksum, kind])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("assets")
}

/// Kept separate from Asset because provenance chains are multi-hop
/// (architecture.md §4.3). `derivedFromAssetIds` is a plain id array, not an
/// FK array (Postgres/Prisma do not support array foreign keys) — it is the
/// authoritative lineage edge list, read by lineage-traversal queries in
/// packages/database's asset-repository.ts.
model AssetProvenance {
  id                     String   @id @default(uuid())
  workspaceId            String
  assetId                String   @unique
  derivedFromAssetIds    String[]
  producedByInvocationId String?
  providerJobRef         String?
  createdAt              DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("asset_provenance_records")
}

/// 0..1 on Asset by design — intermediate assets (proxies, thumbnails) don't need one.
model LicenseRecord {
  id            String      @id @default(uuid())
  workspaceId   String
  assetId       String      @unique
  licenseType   LicenseType
  rightsHolder  String
  restrictions  String[]
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("license_records")
}

/// Backs both COMPOSITING-stage motion-graphics jobs and EXPORTING-stage
/// final renders. `inputAssetIds` is a plain id array, not FK-enforced — see
/// AssetProvenance for the FK-backed lineage edge this complements.
model RenderJob {
  id             String          @id @default(uuid())
  workspaceId    String
  campaignId     String
  kind           RenderJobKind
  status         RenderJobStatus @default(QUEUED)
  inputAssetIds  String[]
  outputAssetId  String?
  providerJobRef String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outputAsset Asset?   @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("render_jobs")
}

enum CompositionJobStatus {
  PENDING
  DISPATCHED
  SUCCEEDED
  FAILED
  BUDGET_EXCEEDED
  CANCELLED
}

enum CompositionAttemptStatus {
  QUEUED
  SUBMITTED
  POLLING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum CompositionFailureReason {
  UNSUPPORTED_CAPABILITY
  PROVIDER_TIMEOUT
  PROVIDER_REJECTED
  PROVIDER_ERROR
  BUDGET_EXCEEDED
}

/// M9 — the canonical versioned rough-edit / timeline specification the Edit
/// Director produces from a human-approved ShotSelectionSet. `tracks` and
/// `overlays` are validated nested structures (Zod) stored as Json, matching
/// ShotSpecification's params/requirements approach. FKs to campaign/concept/
/// script/selection are plain columns (no relation back-reference), matching
/// QualityAssessment/ShotSelectionSet.
model RoughEditSpecification {
  id                      String   @id @default(uuid())
  workspaceId             String
  campaignId              String
  creativeConceptId       String
  creativeConceptVersion  Int
  scriptId                String
  scriptVersion           Int
  shotSelectionSetId      String
  shotSelectionSetVersion Int
  version                 Int
  outputFormat            String
  aspectRatio             String
  resolutionWidth         Int
  resolutionHeight        Int
  frameRate               Int
  targetDurationFrames    Int
  tracks                  Json
  overlays                Json                    @default("[]")
  pacingNotes             String
  beatStructure           Json                    @default("[]")
  continuityNotes         String[]
  textSafeAreas           TextSafeArea[]
  brandTokens             String[]
  captionPlaceholder      String
  musicPlaceholder        String
  sfxPlaceholder          String
  platform                DeliveryPlatform
  platformDeliveryNotes   String
  editRationale           String
  qualityRubric           String[]
  promptVersionId         String
  createdByAgentInvocationId String
  createdAt               DateTime                @default(now())

  compositionJobs CompositionJob[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("rough_edit_specifications")
}

/// M9 — groups the bounded-retry render attempts for one RoughEditSpecification.
model CompositionJob {
  id                       String               @id @default(uuid())
  workspaceId              String
  campaignId               String
  roughEditSpecificationId String
  status                   CompositionJobStatus @default(PENDING)
  maxAttempts              Int
  attemptCount             Int                  @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  roughEditSpecification RoughEditSpecification @relation(fields: [roughEditSpecificationId], references: [id], onDelete: Cascade)
  attempts               CompositionAttempt[]

  @@unique([roughEditSpecificationId])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("composition_jobs")
}

/// M9 — one immutable render attempt within a CompositionJob. `idempotencyKey`
/// is unique per job so a replayed Activity call never double-submits or
/// double-reserves budget.
model CompositionAttempt {
  id                  String                   @id @default(uuid())
  workspaceId         String
  compositionJobId    String
  attemptNumber       Int
  idempotencyKey      String
  providerId          String
  providerProjectId   String?
  providerJobId       String?
  status              CompositionAttemptStatus @default(QUEUED)
  budgetReservationId String?
  estimatedCostCents  Int?
  actualCostCents     Int?
  outputAssetId       String?
  failureReason       CompositionFailureReason?
  failureRetryable    Boolean?
  failureMessage      String?
  startedAt           DateTime                 @default(now())
  completedAt         DateTime?
  createdAt           DateTime                 @default(now())

  compositionJob CompositionJob @relation(fields: [compositionJobId], references: [id], onDelete: Cascade)

  @@unique([compositionJobId, idempotencyKey])
  @@index([workspaceId])
  @@index([compositionJobId])
  @@map("composition_attempts")
}

model SoundCue {
  id             String       @id @default(uuid())
  workspaceId    String
  timelineId     String
  type           SoundCueType
  startFrame     Int
  durationFrames Int
  assetId        String?
  notes          String?
  createdAt      DateTime     @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([timelineId])
  @@map("sound_cues")
}

/// M10 — the Sound Director's canonical, versioned sound-design plan (music
/// brief + mix notes + provenance); its concrete cues are SoundCue rows on the
/// referenced Timeline. FKs to campaign/timeline/rough-edit are plain columns
/// (no relation back-reference), matching RoughEditSpecification/QualityAssessment.
model SoundDesignPlan {
  id                         String   @id @default(uuid())
  workspaceId                String
  campaignId                 String
  timelineId                 String
  roughEditSpecificationId   String
  version                    Int
  musicBrief                 String
  mixNotes                   String
  brandAudioGuidelines       String[]
  qualityRubric              String[]
  promptVersionId            String
  createdByAgentInvocationId String
  createdAt                  DateTime @default(now())

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("sound_design_plans")
}

model EditDecisionList {
  id          String   @id @default(uuid())
  workspaceId String
  campaignId  String
  version     Int
  createdAt   DateTime @default(now())

  campaign Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries  EditDecisionEntry[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("edit_decision_lists")
}

model EditDecisionEntry {
  id                 String        @id @default(uuid())
  workspaceId        String
  editDecisionListId String
  assetId            String
  sourceInFrame      Int
  sourceOutFrame     Int
  timelinePosition   Int
  trackType          EditTrackType
  order              Int

  editDecisionList EditDecisionList @relation(fields: [editDecisionListId], references: [id], onDelete: Cascade)
  asset            Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([editDecisionListId, order])
  @@index([workspaceId])
  @@map("edit_decision_entries")
}

model DeliverySpecification {
  id                   String           @id @default(uuid())
  workspaceId          String
  campaignId           String
  platform             DeliveryPlatform
  aspectRatio          String
  durationSeconds      Int
  safeArea             Json?
  captionBurnRequired  Boolean          @default(false)
  format               String
  createdAt            DateTime         @default(now())

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeVariants CreativeVariant[]

  @@index([workspaceId])
  @@map("delivery_specifications")
}

model CreativeVariant {
  id                      String                @id @default(uuid())
  workspaceId             String
  campaignId              String
  deliverySpecificationId String
  /// M12 — the immutable cut recipe this rendered variant came from. Nullable
  /// only because rows predating M12 have no specification behind them.
  variantSpecificationId  String?
  durationSeconds         Int
  assetId                 String?
  status                  CreativeVariantStatus @default(PENDING)
  /// M12 — the FINAL_QA re-run over this variant (see runVariantFinalQaActivity).
  qualityAssessmentId     String?
  createdAt               DateTime              @default(now())

  campaign              Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverySpecification DeliverySpecification  @relation(fields: [deliverySpecificationId], references: [id], onDelete: Restrict)
  variantSpecification  VariantSpecification?  @relation(fields: [variantSpecificationId], references: [id], onDelete: SetNull)
  asset                   Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  performanceMetrics      PerformanceMetrics[]
  performanceObservations PerformanceObservation[]

  @@index([workspaceId])
  @@index([variantSpecificationId])
  @@map("creative_variants")
}

/// M12 — the named, versioned delivery profile a campaign's variants are cut
/// and judged against (resolves docs/architecture.md §7.2 open question 5).
/// Immutable: a changed requirement is a new version, never an edit.
model DeliveryProfile {
  id                      String   @id @default(uuid())
  workspaceId             String
  key                     String
  version                 Int
  displayName             String
  platforms               DeliveryPlatform[]
  aspectRatio             String
  resolutionWidth         Int
  resolutionHeight        Int
  frameRate               Int
  durationsSeconds        Int[]
  captionBurnRequired     Boolean
  safeAreas               TextSafeArea[]
  ctaTailSeconds          Int?
  ctaMinimumDurationSeconds Int?
  durationToleranceFrames Int      @default(0)
  createdAt               DateTime @default(now())

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variantSpecifications VariantSpecification[]

  @@unique([workspaceId, key, version])
  @@index([workspaceId])
  @@map("delivery_profiles")
}

/// M12 — the canonical, immutable, versioned recipe for one delivery variant:
/// which frames of the approved FINAL_MASTER survive, in what order, with which
/// cues, captions and CTA. Pins the full upstream provenance chain so a variant
/// is always traceable to the exact approved artifacts behind it. Immutable
/// once `approvedForExportAt` is set.
model VariantSpecification {
  id          String @id @default(uuid())
  workspaceId String
  campaignId  String
  version     Int

  parentMasterAssetId          String
  parentFinalQaAssessmentId    String
  timelineId                   String
  timelineVersion              Int
  creativeConceptId            String
  creativeConceptVersion       Int
  scriptId                     String
  scriptVersion                Int
  shotSelectionSetId           String
  shotSelectionSetVersion      Int
  roughEditSpecificationId     String
  roughEditSpecificationVersion Int
  soundDesignPlanId            String
  soundDesignPlanVersion       Int

  deliveryProfileId       String
  deliveryProfileKey      String
  deliveryProfileVersion  Int
  deliverySpecificationId String
  platform                DeliveryPlatform
  targetDurationSeconds   Int
  targetDurationFrames    Int
  aspectRatio             String
  resolutionWidth         Int
  resolutionHeight        Int
  frameRate               Int

  /// Validated nested structures (canonical, not free-form JSON) — same
  /// approach RoughEditSpecification uses for its tracks/overlays.
  cutPoints         Json
  retainedClips     Json
  retainedCues      Json  @default("[]")
  retainedCaptions  Json  @default("[]")
  ctaPlacement      Json
  captionBurnRequired Boolean
  safeAreas         TextSafeArea[]

  cutRationale      String
  removedRationale  String[]
  qualityRubric     String[]

  promptVersionId            String
  createdByAgentInvocationId String
  approvedForExportAt        DateTime?
  supersededAt               DateTime?
  createdAt                  DateTime  @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliveryProfile DeliveryProfile @relation(fields: [deliveryProfileId], references: [id], onDelete: Restrict)
  parentMaster    Asset           @relation("VariantParentMaster", fields: [parentMasterAssetId], references: [id], onDelete: Restrict)

  generationJobs   VariantGenerationJob[]
  creativeVariants CreativeVariant[]

  @@unique([campaignId, parentMasterAssetId, targetDurationSeconds, version])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("variant_specifications")
}

/// M12 — groups the bounded-retry render attempts for one VariantSpecification.
/// Mutable status row (same split as ShotGenerationJob/CompositionJob).
model VariantGenerationJob {
  id                     String                     @id @default(uuid())
  workspaceId            String
  campaignId             String
  variantSpecificationId String
  status                 VariantGenerationJobStatus @default(PENDING)
  maxAttempts            Int
  attemptCount           Int                        @default(0)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  campaign             Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variantSpecification VariantSpecification      @relation(fields: [variantSpecificationId], references: [id], onDelete: Cascade)
  attempts             VariantGenerationAttempt[]

  @@unique([variantSpecificationId])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("variant_generation_jobs")
}

/// M12 — one immutable, append-only variant-render attempt. `idempotencyKey` is
/// unique per job so a replayed Activity call never double-submits or
/// double-reserves budget.
model VariantGenerationAttempt {
  id                     String                         @id @default(uuid())
  workspaceId            String
  variantGenerationJobId String
  attemptNumber          Int
  idempotencyKey         String
  providerId             String
  providerProjectId      String?
  providerJobId          String?
  status                 VariantGenerationAttemptStatus @default(QUEUED)
  budgetReservationId    String?
  estimatedCostCents     Int?
  actualCostCents        Int?
  outputAssetId          String?
  failureReason          VariantGenerationFailureReason?
  failureRetryable       Boolean?
  failureMessage         String?
  startedAt              DateTime                       @default(now())
  completedAt            DateTime?
  createdAt              DateTime                       @default(now())

  variantGenerationJob VariantGenerationJob @relation(fields: [variantGenerationJobId], references: [id], onDelete: Cascade)

  @@unique([variantGenerationJobId, idempotencyKey])
  @@index([workspaceId])
  @@map("variant_generation_attempts")
}

model PerformanceMetrics {
  id                String           @id @default(uuid())
  workspaceId       String
  creativeVariantId String
  platform          DeliveryPlatform
  impressions       Int
  clicks            Int
  conversions       Int
  spendCents        Int
  ctr               Float
  collectedAt       DateTime

  creativeVariant CreativeVariant @relation(fields: [creativeVariantId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([creativeVariantId])
  @@map("performance_metrics")
}

/// M13 — one immutable measurement of one published creative over one closed
/// reporting window. This is architecture.md §4.1's `PerformanceRecord`; it
/// supersedes the thin `PerformanceMetrics` shape above (no post identity, no
/// source provenance, no reporting window, caller-supplied `ctr`), the same way
/// M6's ShotSpecification superseded ShotPrompt. Ingestion is idempotent on
/// `(workspaceId, idempotencyKey)`, so a repeated fixture/manual entry for the
/// same post+window returns the existing row.
model PerformanceObservation {
  id                 String            @id @default(uuid())
  workspaceId        String
  campaignId         String
  platform           DeliveryPlatform
  /// The platform's own post identifier. Opaque; never parsed.
  externalPostId     String
  externalAccountId  String?
  creativeVariantId  String?
  variantAssetId     String?
  durationSeconds    Int?
  source             PerformanceSource
  /// Closed reporting window — `periodEnd` must already have elapsed.
  periodStart        DateTime
  periodEnd          DateTime
  /// Raw counters as reported, and the rates derived from them. Validated
  /// nested structures, same approach RoughEditSpecification uses.
  raw                Json
  normalized         Json
  idempotencyKey     String
  ingestedByUserId   String?
  fixtureRef         String?
  createdAt          DateTime          @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeVariant  CreativeVariant? @relation(fields: [creativeVariantId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([creativeVariantId])
  @@map("performance_observations")
}

/// M13 — a distilled, attributable, versioned creative insight. This is
/// architecture.md §4.1's `Learning`, promoted from the local
/// performance-analyst schema into a real table. Immutable + versioned: a
/// revision writes a new version and marks the prior one superseded, so a
/// Strategy produced under version N stays explicable. `evidence` is an array
/// of PerformanceObservation references — a learning with no evidence is not
/// persistable, and `confidence` is derived from that evidence's volume.
model LearningRecord {
  id                         String             @id @default(uuid())
  workspaceId                String
  version                    Int
  /// Stable identity across versions — a revision keeps the key, bumps version.
  learningKey                String
  insight                    String
  scope                      LearningScope
  /// Applicability restrictions (platforms/durations/tags); an empty array on a
  /// dimension means unrestricted there.
  applicability              Json
  confidence                 LearningConfidence
  /// Explicit PerformanceObservation references, never a prose citation.
  evidence                   Json
  totalImpressions           Int
  status                     LearningStatus     @default(PROPOSED)
  sourceCampaignId           String
  createdByAgentInvocationId String
  promptVersionId            String
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  supersededAt               DateTime?
  createdAt                  DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [sourceCampaignId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, learningKey, version])
  @@index([workspaceId])
  @@index([sourceCampaignId])
  @@map("learning_records")
}

model PromptTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  agentKey    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  PromptVersion[]

  @@unique([workspaceId, agentKey, name])
  @@map("prompt_templates")
}

/// `version` is monotonically increasing per template, never reused —
/// ShotSpecification.promptVersionId pins a generation to exactly one of
/// these rows so "prompt version used for every generation" is always
/// reconstructible.
model PromptVersion {
  id               String   @id @default(uuid())
  workspaceId      String
  promptTemplateId String
  version          Int
  systemPrompt     String
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())

  promptTemplate     PromptTemplate      @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  shotSpecifications ShotSpecification[]

  @@unique([promptTemplateId, version])
  @@index([workspaceId])
  @@map("prompt_versions")
}

/// A configured spending cap at one of the four required levels (workspace,
/// campaign, shot, provider — architecture.md §4.3). `scopeId` is the id of
/// the scoped entity; for level=WORKSPACE, scopeId equals workspaceId.
model BudgetPolicy {
  id          String      @id @default(uuid())
  workspaceId String
  level       BudgetLevel
  scopeId     String
  limitCents  Int
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime    @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   BudgetLedgerEntry[]

  @@unique([workspaceId, level, scopeId])
  @@map("budget_policies")
}

/// Append-only spend ledger (architecture.md §4.3: "No budget row is ever
/// mutated in place"). A BudgetPolicy's remaining amount is always a computed
/// aggregate over this table. `idempotencyKey` is unique per budgetPolicyId so
/// a retried reservation for the same (workflowRunId, stage, entityId, attempt)
/// key never double-reserves.
model BudgetLedgerEntry {
  id               String                @id @default(uuid())
  workspaceId      String
  budgetPolicyId   String
  entryType        BudgetLedgerEntryType
  amountCents      Int
  idempotencyKey   String
  campaignId       String?
  shotId           String?
  generationJobRef String?
  createdAt        DateTime              @default(now())

  budgetPolicy BudgetPolicy @relation(fields: [budgetPolicyId], references: [id], onDelete: Cascade)

  @@unique([budgetPolicyId, idempotencyKey])
  @@index([workspaceId])
  @@map("budget_ledger_entries")
}

/// Append-only audit trail for every transition *attempt* (CLAUDE.md
/// "Transition attempts must be audited"). The unique (campaignId,
/// idempotencyKey) constraint is the idempotency mechanism: a retried
/// request with the same key is answered from this row instead of being
/// re-evaluated — see campaign-transition-service.ts.
model CampaignTransitionAudit {
  id                String                @id @default(uuid())
  workspaceId       String
  campaignId        String
  idempotencyKey    String
  fromStage         CampaignStage
  toStage           CampaignStage
  result            TransitionAuditResult
  reason            String?
  approvalId        String?
  requestedByUserId String?
  createdAt         DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([workspaceId])
  @@map("campaign_transition_audits")
}

enum AgentInvocationStatus {
  SUCCEEDED
  FAILED
}

/// Persists every terminal outcome of a specialist-agent execution (ADR-0004):
/// successful output, schema-validation failure, provider failure, budget
/// rejection, placeholder/unknown-agent rejection, and retry exhaustion. The
/// unique (campaignId, idempotencyKey) constraint is this table's idempotency
/// mechanism — see execute-specialist-agent-activity.ts: an Activity retry
/// that finds an existing row here returns it directly instead of calling the
/// reasoning provider again. `workflowRunId` is the Temporal run id as a plain
/// string, not an FK — no `WorkflowRun` table exists in this schema (it is
/// Postgres's queryable mirror of Temporal state in architecture.md's
/// original ER diagram, not yet implemented; see docs/domain-model.md).
model AgentInvocation {
  id               String                @id @default(uuid())
  workspaceId      String
  campaignId       String
  workflowRunId    String
  stage            CampaignStage
  agentName        String
  agentVersion     Int
  idempotencyKey   String
  correlationId    String
  causationId      String?
  status           AgentInvocationStatus
  result           Json?
  failureReason    String?
  failureRetryable Boolean?
  failureMessage   String?
  failureDetails   Json?
  model            String?
  promptVersion    Int?
  tokensIn         Int?
  tokensOut        Int?
  costCents        Int?
  inputHash        String
  outputHash       String?
  attempt          Int                   @default(1)
  startedAt        DateTime
  completedAt      DateTime
  createdAt        DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([workspaceId])
  @@index([workflowRunId])
  @@map("agent_invocations")
}

// ============================================================================
// Creative Memory â€” reference (inspiration) side.
//
// Deliberately a separate namespace from the production asset tables above.
// Every table is prefixed `reference_` and no relation crosses into Asset,
// LicenseRecord or RenderJob: a benchmark advertisement must not be reachable
// from anything the renderer consults. The rights vocabulary is separate too
// (ReferenceRightsClassification has no output-permitting member), so a
// reference cannot even be spelled in a way production would accept.
//
// See packages/domain's creative-memory.ts and
// docs/runbooks/creative-memory-ingestion.md.
// ============================================================================

enum ReferenceRightsClassification {
  LINK_ONLY
  ANALYSIS_ONLY
  LICENSED_FOR_ANALYSIS
  OWNED_REFERENCE
}

enum SourceAccessBasis {
  PUBLICLY_PUBLISHED_URL
  OPERATOR_LAWFUL_COPY
  DIRECT_LICENCE
  OWN_PAST_WORK
  SUPPLIED_BY_RIGHTS_HOLDER
}

enum ReferenceBusinessRole {
  CAMPAIGN_STRATEGY
  CREATIVE_DIRECTION
  SCRIPT_AND_TIMING
  REFERENCE_INTELLIGENCE
  PREVISUALISATION
  VIDEO_PRODUCTION
  MOTION_AND_TRANSITIONS
  SOUND_AND_MUSIC
  VISUAL_QUALITY_CONTROL
  CONTINUITY_AND_EDITORIAL
  COPY_AND_BRAND_CONTROL
  PLATFORM_OPTIMISATION
  PERFORMANCE_ANALYSIS
}

/// READY_FOR_RETRIEVAL means the analysis pipeline finished and a human
/// approved the annotations. It does NOT mean output-eligible â€” no reference
/// state ever does.
enum ReferenceProcessingState {
  REGISTERED
  VALIDATED
  INSPECTED
  SEGMENTED
  TRANSCRIBED
  PROJECTED
  REVIEW_REQUIRED
  READY_FOR_RETRIEVAL
  FAILED
}

enum ReferenceFailureReason {
  INVALID_MANIFEST
  INVALID_RIGHTS
  UNSAFE_PATH
  MISSING_MEDIA
  INSPECTION_FAILED
  SCENE_DETECTION_FAILED
  DERIVATION_FAILED
  TRANSCRIPTION_UNAVAILABLE
  DUPLICATE_REFERENCE
  PERSISTENCE_FAILED
}

enum ReferenceFrameKind {
  START
  MIDPOINT
  END
}

enum ReferenceDerivedArtifactKind {
  PROXY
  FRAME
  SCENE_CLIP
  TRANSCRIPT
}

enum ReviewerConfidence {
  LOW
  MEDIUM
  HIGH
}

model ReferenceSource {
  id                   String                        @id @default(uuid())
  workspaceId          String
  officialUrl          String?
  accessBasis          SourceAccessBasis
  rightsClassification ReferenceRightsClassification
  rightsHolder         String
  permittedUses        String[]
  prohibitedUses       String[]
  attribution          String?
  jurisdictionNotes    String?
  /// Always true. Persisted rather than derived so a database dump is
  /// self-describing about what these rows may not be used for.
  outputUseProhibited  Boolean                       @default(true)
  createdAt            DateTime                      @default(now())

  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  advertisements ReferenceAdvertisement[]

  @@index([workspaceId])
  @@map("reference_sources")
}

model ReferenceAdvertisement {
  id                      String                   @id @default(uuid())
  workspaceId             String
  referenceSourceId       String
  referenceKey            String
  title                   String
  brand                   String
  campaign                String?
  agency                  String?
  productionCompany       String?
  director                String?
  platform                String?
  publicationYear         Int?
  declaredDurationSeconds Float?
  businessRoles           ReferenceBusinessRole[]
  operatorNotes           String?
  processingState         ReferenceProcessingState @default(REGISTERED)
  failureReason           ReferenceFailureReason?
  failureDetail           String?
  /// False for LINK_ONLY: metadata was registered but no bytes were acquired.
  mediaAcquired           Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  referenceSource ReferenceSource            @relation(fields: [referenceSourceId], references: [id], onDelete: Cascade)
  media           ReferenceMedia?
  scenes          ReferenceScene[]
  frames          ReferenceFrame[]
  transcripts     ReferenceTranscript[]
  annotations     ReferenceAnnotation[]
  craftMetrics    ReferenceCraftMetrics?
  derived         ReferenceDerivedArtifact[]
  indexEntries    CreativeMemoryIndexEntry[]

  @@unique([workspaceId, referenceKey])
  @@index([workspaceId])
  @@index([workspaceId, processingState])
  @@map("reference_advertisements")
}

model ReferenceMedia {
  id                       String   @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String   @unique
  /// Absolute path inside a configured reference root. Never a production path.
  localPath                String
  checksumSha256           String
  sizeBytes                BigInt
  durationSeconds          Float
  widthPx                  Int
  heightPx                 Int
  frameRate                Float
  videoCodec               String
  hasAudio                 Boolean
  audioCodec               String?
  aspectRatio              String
  createdAt                DateTime @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)

  /// Checksum uniqueness per workspace is what makes duplicate ingestion a
  /// detected condition rather than a silently-doubled library.
  @@unique([workspaceId, checksumSha256])
  @@index([workspaceId])
  @@map("reference_media")
}

model ReferenceScene {
  id                       String   @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String
  sceneIndex               Int
  startSeconds             Float
  endSeconds               Float
  durationSeconds          Float
  detectionMethod          String
  detectorConfig           Json     @default("{}")
  confidence               Float?
  createdAt                DateTime @default(now())

  advertisement ReferenceAdvertisement    @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)
  frames        ReferenceFrame[]
  derived       ReferenceDerivedArtifact[]
  indexEntries  CreativeMemoryIndexEntry[]

  @@unique([referenceAdvertisementId, sceneIndex])
  @@index([workspaceId])
  @@map("reference_scenes")
}

model ReferenceFrame {
  id                       String             @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String
  referenceSceneId         String?
  kind                     ReferenceFrameKind
  timestampSeconds         Float
  localPath                String
  checksumSha256           String
  widthPx                  Int
  heightPx                 Int
  createdAt                DateTime           @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)
  scene         ReferenceScene?        @relation(fields: [referenceSceneId], references: [id], onDelete: Cascade)

  @@unique([referenceAdvertisementId, referenceSceneId, kind])
  @@index([workspaceId])
  @@map("reference_frames")
}

model ReferenceTranscript {
  id                       String   @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String
  provider                 String
  model                    String
  language                 String?
  /// Timestamped segments. Written only when a transcript was genuinely
  /// produced â€” never fabricated when the provider is unavailable.
  segments                 Json
  createdAt                DateTime @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)

  @@unique([referenceAdvertisementId, provider, model])
  @@index([workspaceId])
  @@map("reference_transcripts")
}

/// Deterministic measurements only. Subjective judgements belong in
/// ReferenceAnnotation, attributed to a named human.
model ReferenceCraftMetrics {
  id                       String   @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String   @unique
  durationSeconds          Float
  sceneCount               Int
  firstCutSeconds          Float?
  averageSceneSeconds      Float?
  medianSceneSeconds       Float?
  minSceneSeconds          Float?
  maxSceneSeconds          Float?
  cutsPerSecond            Float
  sceneDurationHistogram   Json     @default("{}")
  aspectRatio              String
  widthPx                  Int
  heightPx                 Int
  frameRate                Float
  videoCodec               String
  hasAudio                 Boolean
  audioCodec               String?
  averageBitrateBps        Int?
  peakBitrateBps           Int?
  silenceIntervals         Json     @default("[]")
  blackFrameIntervals      Json     @default("[]")
  createdAt                DateTime @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("reference_craft_metrics")
}

model ReferenceAnnotation {
  id                            String             @id @default(uuid())
  workspaceId                   String
  referenceAdvertisementId      String
  version                       Int
  authorId                      String
  hookMechanism                 String?
  audienceTension               String?
  campaignProposition           String?
  narrativeStructure            String?
  productRevealSeconds          Float?
  ctaSeconds                    Float?
  shotType                      String?
  cameraMovement                String?
  transitionCategory            String?
  typographyBehaviour           String?
  soundProgression              String?
  emotionalMechanism            String?
  platformNativeCharacteristics String?
  /// What may be learned and reapplied â€” a principle, never a reusable asset.
  transferablePrinciple         String
  /// What must not be copied. Stored beside the principle so the lesson and
  /// its boundary always travel together.
  prohibitedDirectSimilarity    String
  reviewerConfidence            ReviewerConfidence
  reviewerNotes                 String?
  approved                      Boolean            @default(false)
  createdAt                     DateTime           @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)

  @@unique([referenceAdvertisementId, version])
  @@index([workspaceId])
  @@map("reference_annotations")
}

model ReferenceIngestionRun {
  id             String    @id @default(uuid())
  workspaceId    String
  idempotencyKey String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  succeededCount Int       @default(0)
  failedCount    Int       @default(0)
  skippedCount   Int       @default(0)
  toolVersions   Json      @default("{}")

  derived ReferenceDerivedArtifact[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@map("reference_ingestion_runs")
}

/// Provenance for every byte derived from a reference. sourceChecksumSha256
/// and extractionCommand are required: a derived file whose origin cannot be
/// named is indistinguishable from an asset of unknown rights.
model ReferenceDerivedArtifact {
  id                       String                       @id @default(uuid())
  workspaceId              String
  referenceAdvertisementId String
  referenceSceneId         String?
  ingestionRunId           String
  kind                     ReferenceDerivedArtifactKind
  localPath                String
  checksumSha256           String
  sizeBytes                BigInt
  sourceChecksumSha256     String
  extractionCommand        String
  toolVersion              String
  /// Always true. Derived analysis media is analysis media.
  analysisOnly             Boolean                      @default(true)
  createdAt                DateTime                     @default(now())

  advertisement ReferenceAdvertisement @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)
  scene         ReferenceScene?        @relation(fields: [referenceSceneId], references: [id], onDelete: Cascade)
  ingestionRun  ReferenceIngestionRun  @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@unique([referenceAdvertisementId, kind, localPath])
  @@index([workspaceId])
  @@map("reference_derived_artifacts")
}

// ============================================================================
// Creative Memory retrieval index state.
//
// PostgreSQL remains canonical: these rows record what was indexed, from which
// input, into which collection, and whether that vector is still current.
// Qdrant holds the vectors and a filterable payload — never rights, never
// provenance, never annotation text.
// ============================================================================

enum CreativeMemoryProfile {
  STRUCTURAL_BASELINE_V1
  QWEN3_VL_2B_QUALITY_V1
  QWEN3_VL_8B_REMOTE_QUALITY_V1
}

enum CreativeMemoryIndexState {
  PENDING
  INDEXING
  INDEXED
  STALE
  DELETED
  FAILED
}

enum CreativeMemoryIndexFailureType {
  EMBEDDING_FAILED
  DIMENSION_MISMATCH
  INVALID_VECTOR
  QDRANT_UNAVAILABLE
  UPSERT_FAILED
  INELIGIBLE
}

model CreativeMemoryIndexRun {
  id                String                @id @default(uuid())
  workspaceId       String
  profile           CreativeMemoryProfile
  qdrantCollection  String
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  indexedCount      Int                   @default(0)
  skippedCount      Int                   @default(0)
  failedCount       Int                   @default(0)

  entries CreativeMemoryIndexEntry[]

  @@index([workspaceId])
  @@map("creative_memory_index_runs")
}

model CreativeMemoryIndexEntry {
  id                       String                          @id @default(uuid())
  workspaceId              String
  referenceSceneId         String
  referenceAdvertisementId String
  profile                  CreativeMemoryProfile
  modelRevision            String
  vectorDimension          Int
  /// sha256 of the canonical embedding input. Any change to a contributing
  /// annotation, transcript, frame or craft metric changes this and marks the
  /// entry STALE.
  embeddingInputHash       String
  vectorChecksum           String
  qdrantCollection         String
  qdrantPointId            String
  state                    CreativeMemoryIndexState        @default(PENDING)
  indexedAt                DateTime?
  lastVerifiedAt           DateTime?
  failureType              CreativeMemoryIndexFailureType?
  /// Redacted before persistence — never carries an endpoint credential.
  failureDetail            String?
  indexRunId               String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt

  scene         ReferenceScene          @relation(fields: [referenceSceneId], references: [id], onDelete: Cascade)
  advertisement ReferenceAdvertisement  @relation(fields: [referenceAdvertisementId], references: [id], onDelete: Cascade)
  indexRun      CreativeMemoryIndexRun? @relation(fields: [indexRunId], references: [id], onDelete: SetNull)

  /// One entry per scene per profile: re-indexing updates in place rather than
  /// accumulating rows, which is what makes indexing idempotent.
  @@unique([referenceSceneId, profile])
  @@index([workspaceId])
  @@index([workspaceId, state])
  @@map("creative_memory_index_entries")
}

// ============================================================================
// Agency benchmark governance (AAMP Creative Memory injection)
//
// Retrieval decides what is *similar*. These rows decide what is *permitted*:
// which specialist role may be influenced by the reference library, for which
// campaigns and platforms, under which top-K, context-budget, diversity and
// originality limits, approved by which named human.
//
// Deliberately still on the reference side of the wall. Nothing here names an
// asset, a path or a licence, and no relation reaches Asset, LicenseRecord or
// RenderJob — a benchmark profile authorises influence on *planning* and can
// never make reference material renderable.
//
// Rows are never edited once activated. A change is a new version carrying
// `supersedesProfileId`, so the chain of who permitted what is auditable
// without a mutation log.
// ============================================================================

enum CreativeMemoryAgentRole {
  CAMPAIGN_STRATEGIST
  CREATIVE_DIRECTOR
  SCRIPT_TIMING_DIRECTOR
  SHOT_PROMPT_ENGINEER
}

enum BenchmarkProfileReviewStatus {
  DRAFT
  APPROVED
  REJECTED
  WITHDRAWN
}

model BenchmarkGovernanceProfile {
  id          String                  @id @default(uuid())
  workspaceId String
  name        String
  version     Int
  agentRole   CreativeMemoryAgentRole

  /// Empty means every platform. Non-empty is an allowlist.
  applicablePlatforms   String[] @default([])
  /// Empty means every campaign in the workspace. Non-empty is an allowlist.
  applicableCampaignIds String[] @default([])

  active       Boolean                      @default(false)
  reviewStatus BenchmarkProfileReviewStatus @default(DRAFT)

  requiredReferenceRoles ReferenceBusinessRole[]
  allowedCollections     String[]                @default([])

  maxTopK               Int
  maxContextCharacters  Int
  maxItemsPerReference  Int
  minDistinctReferences Int

  requireOriginalTransformation Boolean  @default(true)
  prohibitedSimilarityRules     String[]
  /// Days after activation at which this profile must be re-reviewed.
  activationValidForDays        Int?
  /// Days after which an approved annotation is too old to influence a campaign.
  annotationValidForDays        Int?

  reviewerId String?
  approvedAt DateTime?

  /// Immutable activation provenance. Written once, with the row.
  activatedBy            String
  activatedAt            DateTime
  supersedesProfileId    String?
  /// sha256 over the governing fields only, so a tampered row is detectable
  /// while an edited note is not a false alarm.
  governingChecksumSha256 String

  notes     String?
  createdAt DateTime @default(now())

  supersedes BenchmarkGovernanceProfile?  @relation("BenchmarkProfileSupersedes", fields: [supersedesProfileId], references: [id], onDelete: SetNull)
  supersededBy BenchmarkGovernanceProfile[] @relation("BenchmarkProfileSupersedes")

  /// One row per (workspace, name, role, version): a new decision is a new
  /// version, never an update in place.
  @@unique([workspaceId, name, agentRole, version])
  @@index([workspaceId])
  @@index([workspaceId, agentRole, active])
  @@map("benchmark_governance_profiles")
}
