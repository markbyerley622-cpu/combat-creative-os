// Combat Creative OS — foundation schema.
//
// Tenancy core (Workspace, User, Role, Membership) plus the full campaign
// production domain model — see docs/domain-model.md for an ER diagram, the
// campaign state machine this schema backs, and worked examples.
//
// Tenancy-scoping convention (docs/architecture.md §4.4, CLAUDE.md): every
// table below carries a `workspaceId` column with an index. A real FK
// relation to Workspace (with back-relation array) is declared only on
// aggregate roots that are queried/created directly by API/activity code
// (Campaign, Asset, HumanApproval, PromptTemplate, BudgetPolicy,
// BudgetLedgerEntry, CampaignTransitionAudit) — deeply-nested child tables
// (Shot, ShotSpecification, QualityFailure, etc.) rely on their immediate
// parent's FK chain up to Campaign/Workspace for referential integrity, and
// carry `workspaceId` as a denormalized, indexed scoping column so the
// repository layer can always filter directly on it without joining up the
// chain (see packages/database's repository rule in CLAUDE.md). This keeps
// the schema's relation graph readable while still satisfying "every
// workspace-owned table gets a workspaceId column and an index on it."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  OWNER_ADMIN
  CREATIVE_DIRECTOR
  PRODUCTION_OPERATOR
  REVIEWER
  ANALYST
}

model Workspace {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  campaigns                Campaign[]
  assets                   Asset[]
  promptTemplates          PromptTemplate[]
  budgetPolicies           BudgetPolicy[]
  campaignTransitionAudits CampaignTransitionAudit[]
  agentInvocations         AgentInvocation[]

  @@map("workspaces")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  displayName String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

model Membership {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        RoleName
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Campaign production domain (docs/domain-model.md)
// ---------------------------------------------------------------------------

// 20-stage canonical campaign-production lifecycle — see
// docs/domain-model.md §4 and docs/adr/0002-campaign-lifecycle-alignment.md.
// Performance analysis is intentionally NOT represented here; it runs as a
// separate, decoupled PerformanceAnalysisWorkflow over completed campaign/
// distribution records so this workflow can complete without waiting on
// advertising results.
enum CampaignStage {
  DRAFT
  STRATEGY_REVIEW
  CONCEPT_REVIEW
  SCRIPT_REVIEW
  ASSET_COLLECTION
  PROMPTING
  SHOT_GENERATION
  VISUAL_QA
  CONTINUITY_QA
  HUMAN_SHOT_SELECTION
  COMPOSITING
  ROUGH_CUT
  SOUND_DESIGN
  FINAL_QA
  FINAL_APPROVAL
  VARIANT_GENERATION
  VARIANT_QA
  EXPORTING
  READY_FOR_DISTRIBUTION
  DISTRIBUTED
}

enum DeliveryPlatform {
  TIKTOK
  INSTAGRAM_REELS
  YOUTUBE_SHORTS
  GENERIC
}

enum BudgetLevel {
  WORKSPACE
  CAMPAIGN
  SHOT
  PROVIDER
}

enum BudgetLedgerEntryType {
  RESERVATION
  CHARGE
  RELEASE
}

// Only the three architecturally-required gates. STRATEGY_REVIEW and
// SCRIPT_REVIEW are checkpoint stages, not gates — see decision 9 in
// docs/adr/0002-campaign-lifecycle-alignment.md.
enum ApprovalGate {
  CONCEPT
  SHOT_SELECTION
  FINAL
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum AssetKind {
  /// M5: a file uploaded directly by a user — the only kind the ingestion service itself creates.
  UPLOADED_SOURCE
  VIDEO_CANDIDATE
  THUMBNAIL
  PROXY
  MOTION_GRAPHICS_RENDER
  SOUND_STEM
  FINAL_MASTER
  VARIANT
  DESIGN_EXPORT
}

enum GenerationCandidateStatus {
  PENDING
  SUBMITTED
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ShotGenerationJobStatus {
  PENDING
  DISPATCHED
  SUCCEEDED
  FAILED
  BUDGET_EXCEEDED
  CANCELLED
}

/// Per-attempt provider job status, mirrored from `@combat/providers`'s `JobStatus`.
enum ShotGenerationAttemptStatus {
  QUEUED
  SUBMITTED
  POLLING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
}

enum ShotGenerationFailureReason {
  UNSUPPORTED_CAPABILITY
  PROVIDER_TIMEOUT
  PROVIDER_REJECTED
  PROVIDER_ERROR
  BUDGET_EXCEEDED
}

enum MotionIntensity {
  STATIC
  LOW
  MEDIUM
  HIGH
}

enum TextSafeArea {
  TOP
  BOTTOM
  LEFT
  RIGHT
  CENTER
  FULL_SAFE
}

// SHOT_UNUSABLE/COMPOSITING_TECHNICAL/EDIT_TIMING/AUDIO_TECHNICAL drive typed
// revision routing for stages with more than one valid repair target — see
// packages/domain/src/workflow/quality-failure-routing.ts.
enum QualityFailureCategory {
  PROMPT
  GENERATION
  CONTINUITY
  TECHNICAL
  SHOT_UNUSABLE
  COMPOSITING_TECHNICAL
  EDIT_TIMING
  AUDIO_TECHNICAL
}

enum QualityFailureSeverity {
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum AssessedBy {
  AGENT
  HUMAN
}

enum RenderJobKind {
  COMPOSITING
  EXPORT
}

enum RenderJobStatus {
  QUEUED
  SUBMITTED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SoundCueType {
  MUSIC
  SFX
  VOICEOVER
}

enum TransitionType {
  CUT
  DISSOLVE
  WIPE
  FADE_IN
  FADE_OUT
}

enum ShotStatus {
  PENDING
  GENERATING
  QC_REVIEW
  NEEDS_HUMAN
  BUDGET_EXCEEDED
  SELECTED
  REJECTED
}

enum LicenseType {
  FULL_BUY_OUT
  LIMITED_USAGE
  ROYALTY_FREE
  EXCLUSIVE
}

enum CreativeVariantStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

enum TransitionAuditResult {
  APPLIED
  REJECTED_INVALID_TRANSITION
  REJECTED_MISSING_PREREQUISITE
  REJECTED_BUDGET_EXCEEDED
  REJECTED_CONCURRENT_MODIFICATION
  DUPLICATE_IGNORED
}

enum EditTrackType {
  VIDEO
  AUDIO
}

/// Campaign is the aggregate root the state machine (packages/domain/src/workflow)
/// operates on. `version` is an optimistic-concurrency counter — every applied
/// transition is a compare-and-swap update on (id, workspaceId, currentStage,
/// version), which is what makes concurrent transition attempts safe without
/// a Postgres advisory lock (see campaign-transition-service.ts).
model Campaign {
  id             String        @id @default(uuid())
  workspaceId    String
  name           String
  /// Caller-supplied dedup key for POST /campaigns (M4) — same idempotency-key
  /// convention used elsewhere (AgentInvocation, CampaignTransitionAudit,
  /// BudgetLedgerEntry) rather than a new mechanism. Nullable (unlike those
  /// tables) so every pre-M4 test fixture that constructs a CampaignRecord
  /// without one stays valid — Postgres treats each NULL as distinct under
  /// a unique index, so this only enforces dedup when a caller supplies one.
  idempotencyKey String?
  currentStage   CampaignStage @default(DRAFT)
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  briefs               CampaignBrief[]
  strategies           Strategy[]
  concepts             CreativeConcept[]
  scripts              Script[]
  timelines            Timeline[]
  assets               Asset[]
  renderJobs           RenderJob[]
  editDecisionLists    EditDecisionList[]
  deliverySpecs        DeliverySpecification[]
  creativeVariants     CreativeVariant[]
  humanApprovals       HumanApproval[]
  transitionAudits     CampaignTransitionAudit[]
  agentInvocations     AgentInvocation[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@map("campaigns")
}

/// Versioned and immutable once accepted (`acceptedAt` set) — a revision is a
/// new row with an incremented `version`, never a mutation of an existing one.
// M4: the full campaign-brief field set the dashboard's brief editor
// collects — see packages/domain's CampaignBriefContentSchema, the
// single source of truth this model's fields mirror field-for-field.
// Unmigrated (no prisma/migrations directory exists yet, see
// docs/architecture.md §7.1 item 11), so these fields were extended in
// place for M4 rather than added via a follow-up migration.
model CampaignBrief {
  id                 String             @id @default(uuid())
  workspaceId        String
  campaignId         String
  version            Int
  campaignName       String
  productName        String
  productDescription String
  objective          String
  targetAudience     String
  customerProblem    String
  valueProposition   String
  productFeatures    String[]
  targetPlatforms    DeliveryPlatform[]
  aspectRatios       String[]
  durationsSeconds   Int[]
  brandVoice         String
  visualDirection    String
  requiredMessaging  String[]
  callToAction       String
  references         String[]
  assetReferences    String[]
  prohibitedClaims   String[]
  budgetCents        Int
  deadline           DateTime?
  locale             String             @default("en-US")
  notes              String?
  acceptedAt         DateTime?
  createdAt          DateTime           @default(now())

  campaign         Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audienceProfiles AudienceProfile[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("campaign_briefs")
}

// M4: Campaign Strategist's output, persisted as an immutable versioned
// row (packages/domain's StrategySchema). `audienceProfile` is stored as
// JSON rather than reusing the AudienceProfile model above — that model is
// FK-scoped to CampaignBrief, a different aggregate, and isn't guaranteed
// shape-identical to what the agent returns.
model Strategy {
  id                    String   @id @default(uuid())
  workspaceId           String
  campaignId            String
  version               Int
  positioning           String
  targetAudienceSummary String
  keyMessages           String[]
  toneGuidelines        String[]
  audienceProfile       Json
  createdAt             DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("strategies")
}

model AudienceProfile {
  id               String   @id @default(uuid())
  workspaceId      String
  campaignBriefId  String
  name             String
  demographics     Json     @default("{}")
  psychographics   Json     @default("{}")
  painPoints       String[]
  platformBehavior Json     @default("{}")
  createdAt        DateTime @default(now())

  campaignBrief CampaignBrief @relation(fields: [campaignBriefId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignBriefId])
  @@map("audience_profiles")
}

model CreativeConcept {
  id              String   @id @default(uuid())
  workspaceId     String
  campaignId      String
  version         Int
  logline         String
  visualDirection String
  narrativeArc    String
  referenceNotes  String[]
  createdAt       DateTime @default(now())

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  visualLanguage VisualLanguage?
  scripts        Script[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("creative_concepts")
}

/// One-to-one with CreativeConcept — a concept version has exactly one visual
/// language spec; a revised concept version gets a new VisualLanguage row.
model VisualLanguage {
  id                String   @id @default(uuid())
  workspaceId       String
  creativeConceptId String   @unique
  colorPalette      String[]
  typography        Json     @default("{}")
  motionPrinciples  String[]
  brandAssetRefs    String[]
  createdAt         DateTime @default(now())

  creativeConcept CreativeConcept @relation(fields: [creativeConceptId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("visual_languages")
}

model Script {
  id                  String   @id @default(uuid())
  workspaceId         String
  campaignId          String
  creativeConceptId   String
  version             Int
  totalDurationFrames Int
  createdAt           DateTime @default(now())

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeConcept CreativeConcept @relation(fields: [creativeConceptId], references: [id], onDelete: Restrict)
  shots           Shot[]
  timelines       Timeline[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("scripts")
}

// Script & Timing Director's per-shot narrative-beat classification
// (packages/agents/src/script-timing-director/schema.ts's ShotBeatSchema;
// packages/domain mirrors these same four values as ShotBeatSchema so the
// domain package doesn't need to depend on packages/agents).
enum ShotBeat {
  HOOK
  PROMISE
  FEATURE
  CTA
}

model Shot {
  id               String     @id @default(uuid())
  workspaceId      String
  scriptId         String
  index            Int
  description      String
  durationFrames   Int
  beat             ShotBeat
  status           ShotStatus @default(PENDING)
  dependsOnShotIds String[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  script             Script               @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  shotSpecifications ShotSpecification[]
  timelineEntries    TimelineEntry[]

  @@unique([scriptId, index])
  @@index([workspaceId])
  @@map("shots")
}

/// Reusable edit-transition definition (cut/dissolve/wipe/fade), referenced by
/// TimelineEntry. Not to be confused with campaign *stage* transitions.
model TransitionSpecification {
  id             String         @id @default(uuid())
  workspaceId    String
  type           TransitionType
  durationFrames Int
  easing         String?
  params         Json           @default("{}")
  createdAt      DateTime       @default(now())

  timelineEntries TimelineEntry[]

  @@index([workspaceId])
  @@map("transition_specifications")
}

model Timeline {
  id            String   @id @default(uuid())
  workspaceId   String
  campaignId    String
  scriptId      String
  version       Int
  frameRate     Int      @default(30)
  durationFrames Int
  createdAt     DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  script   Script          @relation(fields: [scriptId], references: [id], onDelete: Restrict)
  entries  TimelineEntry[]
  soundCues SoundCue[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("timelines")
}

model TimelineEntry {
  id                        String   @id @default(uuid())
  workspaceId               String
  timelineId                String
  shotId                    String
  transitionSpecificationId String?
  order                     Int
  startFrame                Int
  durationFrames            Int

  timeline               Timeline                 @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  shot                   Shot                     @relation(fields: [shotId], references: [id], onDelete: Restrict)
  transitionSpecification TransitionSpecification? @relation(fields: [transitionSpecificationId], references: [id], onDelete: SetNull)

  @@unique([timelineId, order])
  @@index([workspaceId])
  @@map("timeline_entries")
}

/// Canonical, immutable, versioned generation brief for one shot (M6
/// requirement 3) — the entity the Shot Prompt Engineer agent's output is
/// persisted as. Supersedes the earlier, thinner `GenerationPrompt` model:
/// same slot in the ER graph (a versioned prompt per shot per provider —
/// docs/architecture.md §4), extended with the full structured brief a real
/// shot-generation dispatch needs (framing, continuity, licensing, quality
/// rubric, etc). `promptVersionId` stays a required (non-nullable) FK —
/// CLAUDE.md "Prompt version used for every generation must be recorded" is
/// enforced at the database level, not left to callers to remember.
/// `campaignId`/`creativeConceptId`/`creativeConceptVersion`/`scriptId`/
/// `scriptVersion` are point-in-time-pinned plain columns, not live FKs —
/// this row must keep recording which concept/script version it was
/// generated against even if a later revision supersedes those upstream
/// rows (same "denormalized snapshot, not a live join" rationale as
/// AssetProvenance.derivedFromAssetIds).
model ShotSpecification {
  id                     String   @id @default(uuid())
  workspaceId            String
  campaignId             String
  creativeConceptId      String
  creativeConceptVersion Int
  scriptId               String
  scriptVersion          Int
  shotId                 String
  version                Int

  shotNumber              Int
  sequencePosition        Int
  intendedDurationSeconds Float

  visualObjective          String
  action                   String
  subject                  String
  environment              String
  cameraMovement           String
  lensFraming              String
  lighting                 String
  colorTreatment           String
  motionIntensity          MotionIntensity
  transitionIn             TransitionType
  transitionOut            TransitionType
  textSafeAreas            TextSafeArea[]
  appInterfaceRequirements String?

  referenceAssetIds       String[]
  continuityRequirements  String[]

  providerId        String
  promptVersionId    String
  generationPrompt   String
  negativePrompt     String?
  generationParams   Json     @default("{}")

  outputRequirements Json     @default("{}")
  qualityRubric      String[]
  licensingConstraints String[]

  createdByAgentInvocationId String
  createdAt                  DateTime @default(now())

  shot          Shot                  @relation(fields: [shotId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion         @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)
  candidates    GenerationCandidate[]
  generationJobs ShotGenerationJob[]

  @@unique([shotId, version])
  @@index([workspaceId])
  @@index([shotId])
  @@index([campaignId])
  @@map("shot_specifications")
}

/// Groups the bounded-retry attempt sequence for one ShotSpecification.
/// Mutable status/updatedAt row — same pattern already established by
/// RenderJob/CreativeVariant — because a job's status legitimately changes
/// as attempts are dispatched and resolved.
model ShotGenerationJob {
  id                      String                  @id @default(uuid())
  workspaceId             String
  campaignId              String
  shotSpecificationId     String
  status                  ShotGenerationJobStatus @default(PENDING)
  requestedCandidateCount Int
  maxAttempts             Int
  attemptCount            Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  shotSpecification ShotSpecification       @relation(fields: [shotSpecificationId], references: [id], onDelete: Cascade)
  attempts          ShotGenerationAttempt[]

  @@unique([shotSpecificationId])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("shot_generation_jobs")
}

/// One bounded-retry attempt within a ShotGenerationJob — append-only retry
/// history. `idempotencyKey` is unique per job so a replayed/retried
/// Activity call for the same attempt never double-submits to the provider
/// or double-reserves budget (CLAUDE.md workflow-idempotency rules).
model ShotGenerationAttempt {
  id                      String                      @id @default(uuid())
  workspaceId             String
  shotGenerationJobId     String
  attemptNumber           Int
  idempotencyKey          String
  providerId              String
  providerJobId           String?
  status                  ShotGenerationAttemptStatus @default(QUEUED)
  requestedCandidateCount Int
  seed                    Int?
  generationParams        Json                        @default("{}")
  budgetReservationId     String?
  estimatedCostCents      Int?
  actualCostCents         Int?
  failureReason           ShotGenerationFailureReason?
  failureRetryable        Boolean?
  failureMessage          String?
  startedAt               DateTime                    @default(now())
  completedAt             DateTime?
  createdAt               DateTime                    @default(now())

  shotGenerationJob ShotGenerationJob     @relation(fields: [shotGenerationJobId], references: [id], onDelete: Cascade)
  candidates        GenerationCandidate[]

  @@unique([shotGenerationJobId, idempotencyKey])
  @@index([workspaceId])
  @@index([shotGenerationJobId])
  @@map("shot_generation_attempts")
}

model GenerationCandidate {
  id                      String                    @id @default(uuid())
  workspaceId             String
  shotSpecificationId     String
  shotGenerationAttemptId String
  candidateIndex          Int
  assetId                 String?
  providerCandidateRef    String?
  seed                    Int?
  durationSeconds         Float?
  aspectRatio             String?
  status                  GenerationCandidateStatus @default(PENDING)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  shotSpecification     ShotSpecification     @relation(fields: [shotSpecificationId], references: [id], onDelete: Cascade)
  shotGenerationAttempt ShotGenerationAttempt @relation(fields: [shotGenerationAttemptId], references: [id], onDelete: Cascade)
  asset                 Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  qualityAssessments    QualityAssessment[]

  @@unique([shotGenerationAttemptId, candidateIndex])
  @@index([workspaceId])
  @@index([shotSpecificationId])
  @@index([shotGenerationAttemptId])
  @@map("generation_candidates")
}

/// Assesses either a GenerationCandidate (Visual QC) or a final-master Asset
/// (Final QA) — exactly one of generationCandidateId/assetId is set. This XOR
/// is an application-level invariant (see packages/domain's
/// QualityAssessmentSchema .refine and its repository-layer tests); Prisma
/// does not currently support a declarative cross-column CHECK constraint
/// for it.
model QualityAssessment {
  id                    String        @id @default(uuid())
  workspaceId           String
  generationCandidateId String?
  assetId               String?
  // Disambiguates which stage's output this assessment concerns (VISUAL_QA /
  // CONTINUITY_QA for a candidate; COMPOSITING / ROUGH_CUT / SOUND_DESIGN /
  // FINAL_QA for an asset) — see docs/domain-model.md §5.
  subjectStage          CampaignStage?
  pass                  Boolean
  scores                Json          @default("{}")
  assessedBy            AssessedBy
  createdAt             DateTime      @default(now())

  generationCandidate GenerationCandidate? @relation(fields: [generationCandidateId], references: [id], onDelete: Cascade)
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  failures            QualityFailure[]

  @@index([workspaceId])
  @@index([generationCandidateId])
  @@index([assetId])
  @@map("quality_assessments")
}

model QualityFailure {
  id                  String                 @id @default(uuid())
  workspaceId         String
  qualityAssessmentId String
  category            QualityFailureCategory
  severity            QualityFailureSeverity
  description         String
  suggestedAction     String?
  createdAt           DateTime               @default(now())

  qualityAssessment QualityAssessment @relation(fields: [qualityAssessmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([qualityAssessmentId])
  @@map("quality_failures")
}

/// Immutable once created — architecture.md §0 guiding constraint 3. The
/// repository layer exposes only an insert for this table; a revised
/// decision is a new row, never an update of an existing one.
model HumanApproval {
  id               String           @id @default(uuid())
  workspaceId      String
  campaignId       String
  gate             ApprovalGate
  decision         ApprovalDecision
  stageAtDecision  CampaignStage
  decidedByUserId  String
  comments         String?
  // Required exactly when gate=FINAL and decision != APPROVED (see
  // HumanApprovalSchema's refine in packages/domain); the reviewer's choice
  // among the three valid FINAL_APPROVAL repair targets.
  repairTarget     CampaignStage?
  decidedAt        DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId, gate])
  @@map("human_approvals")
}

// M5: an uploaded asset's lifecycle after `putObject` succeeds — see
// packages/domain's AssetIngestionStatusSchema doc comment.
enum AssetIngestionStatus {
  PENDING
  READY
  FAILED
}

model Asset {
  id          String    @id @default(uuid())
  workspaceId String
  /// The campaign this asset was originally ingested for — see
  /// packages/domain's AssetSchema doc comment on why a workspace-wide
  /// checksum dedup means this isn't necessarily "the only campaign using
  /// this asset."
  campaignId  String
  kind        AssetKind
  s3Key       String    @unique
  checksum    String
  mimeType    String
  /// M5 additions — see packages/domain's AssetSchema.
  originalFilename        String
  sizeBytes               Int
  ingestionStatus         AssetIngestionStatus @default(PENDING)
  mediaMetadata           Json?
  inspectionFailureDetails String?

  createdByAgentInvocationId String?
  uploadedByUserId           String?
  /// M5: set (instead of the other two) for a derived asset an Activity
  /// produced deterministically (thumbnail/proxy) — see packages/domain's
  /// AssetSchema doc comment.
  generatedByActivity        String?
  createdAt                  DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  provenance           AssetProvenance?
  license              LicenseRecord?
  generationCandidates GenerationCandidate[]
  qualityAssessments   QualityAssessment[]
  renderJobOutputs     RenderJob[]
  soundCues            SoundCue[]
  editDecisionEntries  EditDecisionEntry[]
  creativeVariants     CreativeVariant[]

  // Dedup key for "detects duplicate uploads using workspace, checksum and
  // asset type" — deliberately excludes campaignId (a re-upload of the same
  // bytes to a different campaign in the same workspace reuses this row).
  @@unique([workspaceId, checksum, kind])
  @@index([workspaceId])
  @@index([campaignId])
  @@map("assets")
}

/// Kept separate from Asset because provenance chains are multi-hop
/// (architecture.md §4.3). `derivedFromAssetIds` is a plain id array, not an
/// FK array (Postgres/Prisma do not support array foreign keys) — it is the
/// authoritative lineage edge list, read by lineage-traversal queries in
/// packages/database's asset-repository.ts.
model AssetProvenance {
  id                     String   @id @default(uuid())
  workspaceId            String
  assetId                String   @unique
  derivedFromAssetIds    String[]
  producedByInvocationId String?
  providerJobRef         String?
  createdAt              DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("asset_provenance_records")
}

/// 0..1 on Asset by design — intermediate assets (proxies, thumbnails) don't need one.
model LicenseRecord {
  id            String      @id @default(uuid())
  workspaceId   String
  assetId       String      @unique
  licenseType   LicenseType
  rightsHolder  String
  restrictions  String[]
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("license_records")
}

/// Backs both COMPOSITING-stage motion-graphics jobs and EXPORTING-stage
/// final renders. `inputAssetIds` is a plain id array, not FK-enforced — see
/// AssetProvenance for the FK-backed lineage edge this complements.
model RenderJob {
  id             String          @id @default(uuid())
  workspaceId    String
  campaignId     String
  kind           RenderJobKind
  status         RenderJobStatus @default(QUEUED)
  inputAssetIds  String[]
  outputAssetId  String?
  providerJobRef String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outputAsset Asset?   @relation(fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("render_jobs")
}

model SoundCue {
  id             String       @id @default(uuid())
  workspaceId    String
  timelineId     String
  type           SoundCueType
  startFrame     Int
  durationFrames Int
  assetId        String?
  notes          String?
  createdAt      DateTime     @default(now())

  timeline Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([timelineId])
  @@map("sound_cues")
}

model EditDecisionList {
  id          String   @id @default(uuid())
  workspaceId String
  campaignId  String
  version     Int
  createdAt   DateTime @default(now())

  campaign Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries  EditDecisionEntry[]

  @@unique([campaignId, version])
  @@index([workspaceId])
  @@map("edit_decision_lists")
}

model EditDecisionEntry {
  id                 String        @id @default(uuid())
  workspaceId        String
  editDecisionListId String
  assetId            String
  sourceInFrame      Int
  sourceOutFrame     Int
  timelinePosition   Int
  trackType          EditTrackType
  order              Int

  editDecisionList EditDecisionList @relation(fields: [editDecisionListId], references: [id], onDelete: Cascade)
  asset            Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([editDecisionListId, order])
  @@index([workspaceId])
  @@map("edit_decision_entries")
}

model DeliverySpecification {
  id                   String           @id @default(uuid())
  workspaceId          String
  campaignId           String
  platform             DeliveryPlatform
  aspectRatio          String
  durationSeconds      Int
  safeArea             Json?
  captionBurnRequired  Boolean          @default(false)
  format               String
  createdAt            DateTime         @default(now())

  campaign         Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeVariants CreativeVariant[]

  @@index([workspaceId])
  @@map("delivery_specifications")
}

model CreativeVariant {
  id                      String                @id @default(uuid())
  workspaceId             String
  campaignId              String
  deliverySpecificationId String
  durationSeconds         Int
  assetId                 String?
  status                  CreativeVariantStatus @default(PENDING)
  createdAt               DateTime              @default(now())

  campaign              Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverySpecification DeliverySpecification  @relation(fields: [deliverySpecificationId], references: [id], onDelete: Restrict)
  asset                 Asset?                 @relation(fields: [assetId], references: [id], onDelete: SetNull)
  performanceMetrics    PerformanceMetrics[]

  @@index([workspaceId])
  @@map("creative_variants")
}

model PerformanceMetrics {
  id                String           @id @default(uuid())
  workspaceId       String
  creativeVariantId String
  platform          DeliveryPlatform
  impressions       Int
  clicks            Int
  conversions       Int
  spendCents        Int
  ctr               Float
  collectedAt       DateTime

  creativeVariant CreativeVariant @relation(fields: [creativeVariantId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([creativeVariantId])
  @@map("performance_metrics")
}

model PromptTemplate {
  id          String   @id @default(uuid())
  workspaceId String
  agentKey    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  PromptVersion[]

  @@unique([workspaceId, agentKey, name])
  @@map("prompt_templates")
}

/// `version` is monotonically increasing per template, never reused —
/// ShotSpecification.promptVersionId pins a generation to exactly one of
/// these rows so "prompt version used for every generation" is always
/// reconstructible.
model PromptVersion {
  id               String   @id @default(uuid())
  workspaceId      String
  promptTemplateId String
  version          Int
  systemPrompt     String
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())

  promptTemplate     PromptTemplate      @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  shotSpecifications ShotSpecification[]

  @@unique([promptTemplateId, version])
  @@index([workspaceId])
  @@map("prompt_versions")
}

/// A configured spending cap at one of the four required levels (workspace,
/// campaign, shot, provider — architecture.md §4.3). `scopeId` is the id of
/// the scoped entity; for level=WORKSPACE, scopeId equals workspaceId.
model BudgetPolicy {
  id          String      @id @default(uuid())
  workspaceId String
  level       BudgetLevel
  scopeId     String
  limitCents  Int
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime    @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   BudgetLedgerEntry[]

  @@unique([workspaceId, level, scopeId])
  @@map("budget_policies")
}

/// Append-only spend ledger (architecture.md §4.3: "No budget row is ever
/// mutated in place"). A BudgetPolicy's remaining amount is always a computed
/// aggregate over this table. `idempotencyKey` is unique per budgetPolicyId so
/// a retried reservation for the same (workflowRunId, stage, entityId, attempt)
/// key never double-reserves.
model BudgetLedgerEntry {
  id               String                @id @default(uuid())
  workspaceId      String
  budgetPolicyId   String
  entryType        BudgetLedgerEntryType
  amountCents      Int
  idempotencyKey   String
  campaignId       String?
  shotId           String?
  generationJobRef String?
  createdAt        DateTime              @default(now())

  budgetPolicy BudgetPolicy @relation(fields: [budgetPolicyId], references: [id], onDelete: Cascade)

  @@unique([budgetPolicyId, idempotencyKey])
  @@index([workspaceId])
  @@map("budget_ledger_entries")
}

/// Append-only audit trail for every transition *attempt* (CLAUDE.md
/// "Transition attempts must be audited"). The unique (campaignId,
/// idempotencyKey) constraint is the idempotency mechanism: a retried
/// request with the same key is answered from this row instead of being
/// re-evaluated — see campaign-transition-service.ts.
model CampaignTransitionAudit {
  id                String                @id @default(uuid())
  workspaceId       String
  campaignId        String
  idempotencyKey    String
  fromStage         CampaignStage
  toStage           CampaignStage
  result            TransitionAuditResult
  reason            String?
  approvalId        String?
  requestedByUserId String?
  createdAt         DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([workspaceId])
  @@map("campaign_transition_audits")
}

enum AgentInvocationStatus {
  SUCCEEDED
  FAILED
}

/// Persists every terminal outcome of a specialist-agent execution (ADR-0004):
/// successful output, schema-validation failure, provider failure, budget
/// rejection, placeholder/unknown-agent rejection, and retry exhaustion. The
/// unique (campaignId, idempotencyKey) constraint is this table's idempotency
/// mechanism — see execute-specialist-agent-activity.ts: an Activity retry
/// that finds an existing row here returns it directly instead of calling the
/// reasoning provider again. `workflowRunId` is the Temporal run id as a plain
/// string, not an FK — no `WorkflowRun` table exists in this schema (it is
/// Postgres's queryable mirror of Temporal state in architecture.md's
/// original ER diagram, not yet implemented; see docs/domain-model.md).
model AgentInvocation {
  id               String                @id @default(uuid())
  workspaceId      String
  campaignId       String
  workflowRunId    String
  stage            CampaignStage
  agentName        String
  agentVersion     Int
  idempotencyKey   String
  correlationId    String
  causationId      String?
  status           AgentInvocationStatus
  result           Json?
  failureReason    String?
  failureRetryable Boolean?
  failureMessage   String?
  failureDetails   Json?
  model            String?
  promptVersion    Int?
  tokensIn         Int?
  tokensOut        Int?
  costCents        Int?
  inputHash        String
  outputHash       String?
  attempt          Int                   @default(1)
  startedAt        DateTime
  completedAt      DateTime
  createdAt        DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, idempotencyKey])
  @@index([workspaceId])
  @@index([workflowRunId])
  @@map("agent_invocations")
}
