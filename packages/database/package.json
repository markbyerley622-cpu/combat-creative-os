{
  "name": "@combat/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:postgres": "dotenv -e ../../.env -v BUDGET_POSTGRES_INTEGRATION=1 -- vitest run src/repositories/budget-postgres-concurrency.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@combat/domain": "workspace:*",
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
