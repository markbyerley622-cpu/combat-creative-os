{
  "name": "combat-creative-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "aamp:fixtures": "pnpm --filter @combat/media run build && node packages/media/dist/cli/generate-fixtures.js",
    "aamp:render": "pnpm --filter @combat/media run build && node packages/media/dist/cli/render-cli.js",
    "aamp:generate": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/generate-cli.js",
    "aamp:doctor": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/production/doctor-main.js",
    "aamp:benchmark": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/benchmark/benchmark-main.js",
    "aamp:reference": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/creative-memory/reference-cli-main.js",
    "aamp:capture-app": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/capture/capture-main.js",
    "aamp:media": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/media/media-main.js",
    "aamp:launch": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/launch/launch-main.js",
    "aamp:finish": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/finishing/finishing-main.js",
    "aamp:flagship": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/flagship/flagship-main.js",
    "aamp:flagship2": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/flagship/flagship2-main.js",
    "aamp:storyboard-video": "pnpm --filter aamp-cli run build && node --env-file-if-exists=.env apps/aamp-cli/dist/storyboard-video/storyboard-video-main.js",
    "aamp:motion-review": "pnpm --filter aamp-cli run build && node apps/aamp-cli/dist/storyboard-video/motion-review-main.js",
    "aamp:product-motion": "pnpm --filter aamp-cli run build && node apps/aamp-cli/dist/product-motion/product-motion-main.js",
    "db:generate": "pnpm --filter @combat/database run generate",
    "db:migrate": "pnpm --filter @combat/database run migrate",
    "db:validate": "pnpm --filter @combat/database run validate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  }
}
