{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@combat/agents": "workspace:*",
    "@combat/config": "workspace:*",
    "@combat/database": "workspace:*",
    "@combat/observability": "workspace:*",
    "@combat/providers": "workspace:*",
    "@combat/workflows": "workspace:*",
    "@temporalio/activity": "^1.11.6",
    "@temporalio/worker": "^1.11.6"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
