{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/index.ts",
    "dev:fake": "tsx src/dev-fake-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@combat/config": "workspace:*",
    "@combat/database": "workspace:*",
    "@combat/domain": "workspace:*",
    "@combat/observability": "workspace:*",
    "@combat/providers": "workspace:*",
    "@combat/workflows": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@temporalio/client": "^1.11.6",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
