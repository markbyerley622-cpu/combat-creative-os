{
  "name": "aamp-cli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:live-capture": "vitest run src/capture/live-capture-acceptance.test.ts"
  },
  "dependencies": {
    "@combat/agent-runtime": "workspace:*",
    "@combat/agents": "workspace:*",
    "@combat/config": "workspace:*",
    "@combat/database": "workspace:*",
    "@combat/domain": "workspace:*",
    "@combat/media": "workspace:*",
    "@combat/observability": "workspace:*",
    "@combat/providers": "workspace:*",
    "playwright": "^1.47.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
