  "targetDurationSeconds": 15,
  "strategy": {
    "audienceName": "Multi-promotion combat sports fans, 18-34",
    "painPoints": [
      "The cards they care about sit across different promotions, broadcasters and time zones",
      "They find out a fight happened after it happened",
      "They have an opinion about a matchup and nowhere to put it before the result lands"
    ],
    "positioning": "The one place the whole of combat sports is already organised: what is on, who is ranked, how the matchup reads, what you predicted and where that leaves you.",
    "targetAudienceSummary": "Combat sports fans aged 18-34 who follow more than one promotion and argue about results after every card",
    "keyMessages": [
      "Every fight, from every combat sport, in one place",
      "Research the division, read the matchup, then make a free prediction",
      "Correct predictions build a record, and the argument carries on afterwards"
    ],
    "toneGuidelines": [
      "Certain and physical; the product does the talking",
      "Fight-night late-night, never broadcast-graphics bright",
      "Red is a signal, never a wash"
    ]
  },
  "creativeDirection": {
    "logline": "A notification starts it, the product answers it in four escalating moves, and the record you build is the reason you come back.",
    "visualDirection": "The locked storyboard is the picture. Each landscape panel is contained at full width over a heavily blurred, darkened backplate built from its own pixels, so no composition is cropped and no headline is lost to a vertical crop. Movement always points at the product and always decelerates into a screen that has to be read. Red is reserved for four moments: the notification ring, the tap, the submission flash and the call to action.",
    "narrativeArc": "Notification, breadth, discovery, research, comparison, decision, submission, reward, argument, resolve. Ten scenes in the order the storyboard locked them, each earning the next.",
    "referenceNotes": [
      "Pacing accelerates into the submission and decelerates hard through the last two scenes",
      "Every transition carries a visual idea across the cut rather than demonstrating an effect",
      "The final stretch is a clean stable hold so the call to action can be read"
    ]
  },
  "hook": {
    "strategy": "Open on the notification the storyboard designed, and let a slow push and one red pulse make it the only thing in the frame.",
    "latencySeconds": 0.25,
    "onScreenLine": "FIGHTS THIS WEEKEND"
  },
